{% schema %}
{
  "name": "Hero Media",
  "settings": [
    {
      "type": "header",
      "content": "Media Settings"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Select Image"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Select Video"
    },
    {
      "type": "checkbox",
      "id": "use_video",
      "label": "Use video instead of image",
      "default": false
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height (vh)",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    },

    {
      "type": "header",
      "content": "Overlay Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable overlay background",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    },

    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Heading Here"
    },
    {
      "type": "color",
      "id": "heading_text_color",
      "label": "Heading Text Color",
      "default": "#ffffff"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Your Subheading Here"
    },
    {
      "type": "color",
      "id": "subheading_text_color",
      "label": "Subheading Text Color",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#F26531"
    },

    {
      "type": "header",
      "content": "Bottom Text Row"
    },
    {
      "type": "text",
      "id": "left_text",
      "label": "Left Text",
      "default": "Australian Made"
    },
    {
      "type": "color",
      "id": "left_text_color",
      "label": "Left Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Right Text",
      "default": "Est 2022"
    },
    {
      "type": "color",
      "id": "right_text_color",
      "label": "Right Text Color",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Styles & Spacing"
    },
    {
      "type": "range",
      "id": "top_padding",
      "label": "Top padding (px)",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 60
    },
    {
      "type": "range",
      "id": "bottom_padding",
      "label": "Bottom padding (px)",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show divider border",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Hero Media"
    }
  ]
}
{% endschema %}

<section
  class="fullscreen-media-overlay"
  style="height: {{ section.settings.section_height }}vh; position: relative; overflow: hidden;"
>
  {% if section.settings.use_video and section.settings.background_video != blank %}
    {{ section.settings.background_video | video_tag: image_size: '', autoplay: true, loop: true, controls: false, muted: true, playsinline: true, class:"bg-media" }}
  {% elsif section.settings.background_image != blank %}
    <img src="{{ section.settings.background_image | image_url: width: 2000 }}" width="auto" height="auto" alt="" class="bg-media" loading="lazy">
  {% endif %}

  {% if section.settings.enable_overlay %}
    <div class="overlay"
      style="background-color: {{ section.settings.overlay_color }};
             opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
      ">
    </div>
  {% endif %}

  <div class="content"
    style="padding-top: {{ section.settings.top_padding }}px;
           padding-bottom: {{ section.settings.bottom_padding }}px;">
    <div class="text-wrapper">
      {% if section.settings.heading != blank %}
        <h1 style="color: {{ section.settings.heading_text_color }};">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="subheading"
           style="color: {{ section.settings.subheading_text_color }};">
          {{ section.settings.subheading }}
        </p>
      {% endif %}

      {% if section.settings.show_border %}
        <div class="divider" style="border-bottom: 1px solid {{ section.settings.border_color }};"></div>
      {% endif %}

      <div class="bottom-row">
        <span style="color: {{ section.settings.left_text_color }};">
          {{ section.settings.left_text }}
        </span>

        {% if section.settings.show_button and section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}"
             class="btn"
             style="color: {{ section.settings.button_text_color }};
                    background-color: {{ section.settings.button_bg_color }};">
            {{ section.settings.button_label }}
          </a>
        {% endif %}

        <span style="color: {{ section.settings.right_text_color }};">
          {{ section.settings.right_text }}
        </span>
      </div>
    </div>
  </div>
</section>

<style>
.fullscreen-media-overlay .bg-media {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.fullscreen-media-overlay img ,
.fullscreen-media-overlay video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.fullscreen-media-overlay .overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
}

.fullscreen-media-overlay .content {
  position: relative;
  z-index: 2;
  width: 100%;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  padding: 0 3%;
}

.fullscreen-media-overlay .text-wrapper {
  width: 100%;
  margin: 0 auto;
}

.fullscreen-media-overlay h1 {
  font-size: 6rem;
  line-height: 1;
  margin: 0;
  padding: 4px 10px;
}

.fullscreen-media-overlay .subheading {
  font-size: 14px;
  margin: 0 auto 1rem;
  max-width: 725px;
  padding: 3px 8px;
}

.fullscreen-media-overlay .divider {
  width: 100%;
  display: block;
  margin: 1rem 0;
}

.fullscreen-media-overlay .btn {
  display: inline-block;
  padding: 7px 20px;
  text-decoration: none;
  border-radius: 4px;
  margin: 0px;
  line-height: normal;
font-size: 14px;
}

.fullscreen-media-overlay .bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  font-size: 14px;
  margin-top: 1rem;
}
@media (max-width: 768px){
.fullscreen-media-overlay{
    height: 75vh !important;
}
.fullscreen-media-overlay h1 {
    font-size: 38px;
    padding: 0;
}
.fullscreen-media-overlay .subheading {
    font-size: 12px;
}
}
</style>