<section
  id="whats-on-testimonials"
  class="whats-on-testimonials-main"
  style="
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  "
>
  <div class="whats-on-testimonial">
    <div class="header-text heder--text--test" >
      <h2
        style="
          color: {{ section.settings.text_color }};
          font-size: {{ section.settings.heading_size }}px;
          margin: 10px 0;
        "
      >
        {{ section.settings.heading }}
      </h2>
    </div>
    <div class="testimonial-container {% if section.settings.layout == 'grid' %}grid-layout{% else %}slider-layout{% endif %}">
      {% for block in section.blocks %}
        <div class="testimonial_content">
          <div class="custom-testimonial-heading">{{ block.settings.block_heading }}</div>
          <div class="custom-testimonial-text">{{ block.settings.block_text }}</div>
          <ul class="custom-testimonial-points">
            {% assign points_list = block.settings.points | split: ',,' %}
            {% for point in points_list %}
                <li>{{ point | strip }}</li>
            {% endfor %}
            </ul>
          {% if block.settings.button_link %}
            <div style="
                display: flex;
                justify-content: start;
                align-items: center;
            ">
            <a href="{{ block.settings.button_link }}" class="custom-button">
              {{ block.settings.button_text }}
            </a>
          </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
  {% if section.settings.layout == 'Slider' %}
    <div class="nav-buttons">
      <button class="button-prev-test">
        <img
          src="https://cdn.shopify.com/s/files/1/0949/0576/2156/files/Group_47.png?v=1762885714"
          width="30"
          height="30"
        >
      </button>
      <button class="button-next-test">
        <img
          src="https://cdn.shopify.com/s/files/1/0949/0576/2156/files/Group_48.png?v=1762885714"
          width="30"
          height="30"
        >
      </button>
    </div>
  {% endif %}
  {% if section.settings.show_bottom_marquee %}
    <div class="bottom-marquee-test">
      <div class="marquee-track-test">
        {% for i in (1..100) %}
          <div class="marquee-logos-test"></div>
        {% endfor %}
        {% for i in (1..100) %}
          <div class="marquee-logos-test"></div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

<style>
  .whats-on-testimonials-main {
      margin: 40px 0;
      border-radius: 20px 20px 0 0;
      padding-bottom: 20px;
      position: relative;
  }
  .header-text.heder--text--test h2{
  text-align:center;
}
  .whats-on-testimonial{
      padding: 4% 4% 1%;
  }
  .whats-on-testimonial .container {
    margin: auto;
  }
  .content_desp{
      font-weight: 500;
      line-height: normal;
      margin: 30px 0;
      max-width: 950px;
  }
  .custom-testimonial-heading{
      font-size: 20px;
      font-weight: 600;
      line-height: normal;
      margin: 0;
  }
  .star_rating{
      font-weight: 600;
      font-size: 22px;
      line-height: normal;
  }

  .nav-buttons button {
    background: {{ section.settings.button_bg }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    font-size: 2rem;
    color: {{ section.settings.text_color }};
      width: 30px;
      height: 30px;
      padding: 0;
  }
  .button-next-test ,
  .button-prev-test {
      display: flex;
  }
  .testimonial-card {
      width: 100%;
      padding: 0 5px;
  }
  .product-info {
      padding: 15px;
  }
  .testimonial_content{
      width: 50%;
    padding-right: 20px;
  }
  .testimonial-container .flickity-page-dots {
      flex-wrap: nowrap;
      display: flex;
      position: absolute;
      width: 20%;
      bottom: -80px;
      padding: 0;
      margin: 0;
      list-style: none;
      text-align: center;
      line-height: 1;
      right: 0%;
      transform: translateX(-0%);
  }
  .nav-buttons{
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      padding: 0 5% 4%;
  }
  .testimonial-container .flickity-page-dots .dot.is-selected {
      background: #000;
  }
  .testimonial-container .flickity-page-dots .dot {
      width: 100%;
      height: 3px;
      margin: 0;
      border-radius: 0;
      background: #fff;
      opacity: 1;
  }
  .testimonial-container .flickity-page-dots .dot:first-child {
      border-radius: 10px 0 0 10px;
  }
  .testimonial-container .flickity-page-dots .dot:last-child {
      border-radius: 0 10px 10px 0;
  }
  .testimonial-container .flickity-prev-next-button {
      top: -10%;
      width: 30px;
      height: 30px;
      opacity: 0 !important;
  }
  .testimonial-container .flickity-prev-next-button.previous {
      left: auto;
      right: 173px;
  }
  .testimonial-container .flickity-prev-next-button.next {
      right: 132px;
  }
  .bottom-marquee-test {
      display: flex;
      align-items: center;
      overflow: hidden;
      position: relative;
      white-space: nowrap;
      }

      .marquee-track-test {
      display: flex;
      gap: 10px;
      animation: marquee-logos-test 100s linear infinite;
      }

      .marquee-logos-test {
      display: block !important;
      width: 25px;
      height: 14px;
      border-radius: 5px;
      background: #fff;
      }

      @keyframes marquee-logos-test {
          from {
              transform: translateX(0);
          }
          to {
              transform: translateX(-50%);
          }
      }
  @media (max-width: 1500px) {
      .testimonial-container .flickity-page-dots {
          bottom: -70px;
      }
  }
  @media (max-width: 1500px) {
      .testimonial-container .flickity-page-dots {
          bottom: -70px;
      }
  }
  @media (max-width: 1100px) {
    .testimonial_content{
      width: 100%;
        padding-right: 0px;
    }
      .testimonial-container .flickity-page-dots {
          bottom: -60px;
      }
  }
  @media (max-width: 999px) {
      .testimonial-card {
          width: 100%;
      }
      .header-row {
          padding: 15px 0px 40px;
      }
  }

  @media (max-width: 600px) {
      .testimonial-card {
          width: 100%;
      }
      .header-row {
          padding: 15px 0px 20px;
      }
      .header-text h2{
          font-size: 20px !important;
      }
      .header-text p{
          font-size: 12px !important;
      }
      .content_desp {
          margin: 15px 0;
          font-size: 20px !important;
      }
      .nav-buttons {
          padding: 0 5% 7%;
      }
      .testimonial-container .flickity-page-dots {
          bottom: -45px;
      }
      .custom-testimonial-heading {
          font-size: 16px;
      }
      .star_rating {
          font-size: 18px;
      }
      .testimonial-container .flickity-page-dots {
          width: 40%;
      }
  }
  a.custom-button {
    text-decoration: none;
    color: white;
    background: black;
    padding: 10px 14px;
    border-radius: 8px;
}

/* Slider Layout */
.testimonial-container.slider-layout {
  display: block;
}

/* Grid Layout */
.testimonial-container.grid-layout {
  display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
    row-gap: 32px;
    padding-bottom: 20px;
}
.testimonial-container.grid-layout .testimonial_content {
    width: 100%;
    padding-right: 0 !important;
}

@media screen and (max-width: 767px) {
    .testimonial-container.grid-layout {
        grid-template-columns: 1fr;
    }
}
</style>

{% if section.settings.layout == 'Slider' %}
  <link rel="stylesheet" href="https://unpkg.com/flickity@2/dist/flickity.min.css">
  <script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js"></script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const sliderElem = document.querySelector('.testimonial-container');
      if (!sliderElem) return;

      const flkty = new Flickity(sliderElem, {
        cellAlign: 'left',
        groupCells: true,
        contain: true,
        pageDots: true,
        prevNextButtons: false,
        wrapAround: false,
        draggable: true,
      });

      const prevBtn = document.querySelector('.button-prev-test');
      const nextBtn = document.querySelector('.button-next-test');

      if (prevBtn) prevBtn.addEventListener('click', () => flkty.previous());
      if (nextBtn) nextBtn.addEventListener('click', () => flkty.next());

      let wheelTimer;
      sliderElem.addEventListener(
        'wheel',
        function (e) {
          if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
          if (wheelTimer) return;
          if (e.deltaX > 0) flkty.next();
          else flkty.previous();
          wheelTimer = setTimeout(() => (wheelTimer = null), 300);
        },
        { passive: true }
      );
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Develop & Scan Info",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#FEC340"
    },
    {
      "type": "radio",
      "id": "layout",
      "label": "Layout Type",
      "options": [
        {
          "value": "slider",
          "label": "Slider"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "slider"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Testimonials Peoples"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Arrow Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_marquee",
      "label": "Show Marquee",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "default": 28,
      "min": 16,
      "max": 100,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Font Size Description",
      "default": 32,
      "min": 12,
      "max": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "testimonials-content",
      "name": "Information",
      "settings": [
        {
          "type": "text",
          "id": "block_heading",
          "label": "Block Heading",
          "default": "Customer Testimonial"
        },
        {
          "type": "textarea",
          "id": "block_text",
          "label": "Block Text",
          "default": "Here's what our customers say about us."
        },
        {
          "type": "textarea",
          "id": "points",
          "label": "Points (comma separated)",
          "default": "Fast turnaround, High quality, Great customer service"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Develop & Scan Info",
      "blocks": [
        {
          "type": "testimonials-content",
          "settings": {
          }
        }
      ]
    }
  ]
}
{% endschema %}
