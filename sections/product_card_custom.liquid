{% schema %}
{
  "name": "Product Cards Custom",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Your Section Title"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Section Description",
      "default": "Your description goes here."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title & Description Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Title Font Size (px)",
      "min": 12,
      "max": 60,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "desc_size",
      "label": "Description Font Size (px)",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 16
    },
    {
      "type": "text",
      "id": "section_padding",
      "label": "Section Padding",
      "default": "40px"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "Overlay Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Image"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card Link"
        },
        {
          "type": "text",
          "id": "card_title",
          "label": "Card Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Cards Custom"
    }
  ]
}
{% endschema %}

<section class="two-card-section" style="padding: {{ section.settings.section_padding }}; color: {{ section.settings.text_color }};">
  <div class="container" style="text-align:center;">
    {% if section.settings.section_title != blank %}
      <h2 class="heading_card_sect" style="font-size: {{ section.settings.text_size }}px; margin-bottom: 15px;">{{ section.settings.section_title }}</h2>
    {% endif %}
    
    {% if section.settings.section_description != blank %}
      <p class="description_card_sect" style="font-size: {{ section.settings.desc_size }}px; max-width:300px; margin: 0 auto 40px auto;">{{ section.settings.section_description }}</p>
    {% endif %}
    
    <div class="cards-wrapper" style="display:flex; gap:20px; justify-content:center; flex-wrap:wrap;width: 100%;">
      {% for block in section.blocks %}
        <div class="card-product-s" style="display: flex;width: 100%;background-color: {{ section.settings.card_bg }}; flex:1; border-radius:10px; overflow:hidden; position:relative;padding: 70px;">
          {% if block.settings.card_link != blank %}
            <a href="{{ block.settings.card_link }}" style="display:block; position:relative;width:100%;">
          {% endif %}
              {% if block.settings.card_image != blank %}
                <div class="image_of_card">
                  <img src="{{ block.settings.card_image | img_url: 'master' }}" alt="" style="width:100%; display:block;">
                </div>
              {% endif %}
              {% if block.settings.card_title != blank %}
                <div class="overlay-title" style="position:absolute; bottom:0; left:0; width:100%; text-align:center; color: {{ section.settings.overlay_text_color }}; padding:0 0 20px 0; font-size: 14px;">
                  {{ block.settings.card_title }}
                </div>
              {% endif %}
          {% if block.settings.card_link != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.image_of_card{
    width: 65%;
    height: 75%;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: center;
}
.image_of_card img{
  width: 100%;
  height: 100%;
  object-fit: contain;
}
  @media (max-width: 768px) {
    .cards-wrapper {
      flex-direction: column;
      gap: 15px;
    }
  }
</style>
