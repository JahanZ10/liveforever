<section id="lab-locations-{{ section.id }}" class="lab-locations-section">
  <div class="page-width">

    {%- if section.settings.main_heading != blank -%}
      <div class="lab-locations__header">
        <span class="lab-icon-wrapper lab-icon-wrapper--main" aria-hidden="true">
          <!-- Lab / flask icon -->
          <svg viewBox="0 0 24 24" class="lab-icon lab-icon--lab">
            <path d="M7 3h2v7.59l-3.3 5.72A3 3 0 0 0 8.3 21h7.4a3 3 0 0 0 2.6-4.69L15 10.59V3h2a1 1 0 1 0 0-2H7a1 1 0 0 0 0 2zm2.62 9h4.76l2.62 4.54A1 1 0 0 1 15.7 19H8.3a1 1 0 0 1-.87-1.46L9.62 12z"/>
          </svg>
        </span>
        <h2 class="lab-locations__heading">{{ section.settings.main_heading }}</h2>
      </div>
    {%- endif -%}

    <!-- Main location card -->
    <div class="lab-locations__main-card">
      <div class="lab-locations__main-inner">

        <!-- INFO FIELDS WITH ICONS -->
        <div class="lab-locations__main-info">
          <div class="lab-main-info-list">

            {%- if section.settings.main_address != blank -%}
              <div class="lab-main-info-item">
                <span class="lab-icon-wrapper lab-icon-wrapper--small" aria-hidden="true">
                  <!-- Location pin -->
                  <svg viewBox="0 0 24 24" class="lab-icon lab-icon--pin">
                    <path d="M12 2.5A6.5 6.5 0 0 0 5.5 9c0 3.61 3.33 7.63 5.4 9.82a1 1 0 0 0 1.2 0C15.17 16.63 18.5 12.6 18.5 9A6.5 6.5 0 0 0 12 2.5zm0 2A4.5 4.5 0 0 1 16.5 9c0 2.37-2.18 5.39-4.5 7.85C9.68 14.39 7.5 11.37 7.5 9A4.5 4.5 0 0 1 12 4.5zm0 2.5A2 2 0 1 0 14 9a2 2 0 0 0-2-2z"/>
                  </svg>
                </span>
                <div class="lab-main-info-content">
                  <h3 class="lab-main-info-title">Address</h3>
                  <div class="lab-main-info-text">
                    {{ section.settings.main_address }}
                  </div>
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.lab_reception != blank -%}
              <div class="lab-main-info-item">
                <span class="lab-icon-wrapper lab-icon-wrapper--small" aria-hidden="true">
                  <!-- People / reception icon -->
                  <svg viewBox="0 0 24 24" class="lab-icon lab-icon--reception">
                    <path d="M12 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6zm0 8a5 5 0 0 0-5 5v3h2v-3a3 3 0 0 1 6 0v3h2v-3a5 5 0 0 0-5-5z"/>
                  </svg>
                </span>
                <div class="lab-main-info-content">
                  <h3 class="lab-main-info-title">Lab Reception</h3>
                  <div class="lab-main-info-text">
                    {{ section.settings.lab_reception }}
                  </div>
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.film_dropoff != blank -%}
              <div class="lab-main-info-item">
                <span class="lab-icon-wrapper lab-icon-wrapper--small" aria-hidden="true">
                  <!-- Film / box icon -->
                  <svg viewBox="0 0 24 24" class="lab-icon lab-icon--film">
                    <path d="M5 4h14a1 1 0 0 1 1 1v14l-4-2-4 2-4-2-4 2V5a1 1 0 0 1 1-1zm1 2v10.38l3-1.5 4 2 4-2 3 1.5V6H6zm3 1h2v2H9V7zm4 0h2v2h-2V7zM9 11h2v2H9v-2zm4 0h2v2h-2v-2z"/>
                  </svg>
                </span>
                <div class="lab-main-info-content">
                  <h3 class="lab-main-info-title">Film Drop-Off</h3>
                  <div class="lab-main-info-text">
                    {{ section.settings.film_dropoff }}
                  </div>
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.negative_collection != blank -%}
              <div class="lab-main-info-item">
                <span class="lab-icon-wrapper lab-icon-wrapper--small" aria-hidden="true">
                  <!-- Lock / secure box icon -->
                  <svg viewBox="0 0 24 24" class="lab-icon lab-icon--lock">
                    <path d="M17 9h-1V7a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2zm-7-2a2 2 0 0 1 4 0v2h-4V7zm7 11H7v-7h10v7zm-5-5a1 1 0 0 0-1 1v2h2v-2a1 1 0 0 0-1-1z"/>
                  </svg>
                </span>
                <div class="lab-main-info-content">
                  <h3 class="lab-main-info-title">Negative Collection</h3>
                  <div class="lab-main-info-text">
                    {{ section.settings.negative_collection }}
                  </div>
                </div>
              </div>
            {%- endif -%}

          </div>
        </div>

        <!-- MAP BELOW INFO -->
        <div class="lab-locations__main-map">
          {%- if section.settings.main_map_iframe != blank -%}
            <div class="lab-locations__map-embed">
              {{ section.settings.main_map_iframe }}
            </div>
          {%- endif -%}
        </div>

      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="lab-locations__subheader-row">
        {%- if section.settings.sub_heading != blank -%}
          <div class="lab-locations__subheading-wrap">
            <span class="lab-icon-wrapper lab-icon-wrapper--sub" aria-hidden="true">
              <!-- Map icon -->
              <svg viewBox="0 0 24 24" class="lab-icon lab-icon--map">
                <path d="M9.5 3.05 4.62 4.87A2 2 0 0 0 3 6.76v10.69A1.5 1.5 0 0 0 5.03 18.8L9.5 17.2l5 1.88 4.88-1.82A2 2 0 0 0 21 15.37V4.68A1.5 1.5 0 0 0 18.97 3.4L14.5 5l-5-1.95zm-.5 2.3 5 1.95 4-1.49v9.42l-3.5 1.31-5-1.88-4.5 1.68V6.76z"/>
              </svg>
            </span>
            <h3 class="lab-locations__subheading">{{ section.settings.sub_heading }}</h3>
          </div>
        {%- endif -%}
      </div>

      <!-- Sub locations grid -->
      <div class="lab-locations__grid">
        {%- for block in section.blocks -%}
          <div class="lab-location-card" {{ block.shopify_attributes }}>
            <div class="lab-location-card__header">
              <span class="lab-icon-wrapper lab-icon-wrapper--small" aria-hidden="true">
                <!-- Small pin -->
                <svg viewBox="0 0 24 24" class="lab-icon lab-icon--pin">
                  <path d="M12 2.5A6.5 6.5 0 0 0 5.5 9c0 3.61 3.33 7.63 5.4 9.82a1 1 0 0 0 1.2 0C15.17 16.63 18.5 12.6 18.5 9A6.5 6.5 0 0 0 12 2.5zm0 2A4.5 4.5 0 0 1 16.5 9c0 2.37-2.18 5.39-4.5 7.85C9.68 14.39 7.5 11.37 7.5 9A4.5 4.5 0 0 1 12 4.5zm0 2.5A2 2 0 1 0 14 9a2 2 0 0 0-2-2z"/>
                </svg>
              </span>
              {%- if block.settings.title != blank -%}
                <h4 class="lab-location-card__title">{{ block.settings.title }}</h4>
              {%- endif -%}
            </div>

            {%- if block.settings.description != blank -%}
              <div class="lab-location-card__description">
                {{ block.settings.description }}
              </div>
            {%- endif -%}

            {%- if block.settings.map_iframe != blank -%}
              <div class="lab-location-card__map">
                {{ block.settings.map_iframe }}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>


  {% style %}
    #lab-locations-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background: {{ section.settings.background_color }};
    }

    #lab-locations-{{ section.id }} .lab-locations__header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 24px;
    }

    #lab-locations-{{ section.id }} .lab-locations__heading {
      margin: 0;
      font-size: 28px;
      line-height: 1.2;
      letter-spacing: 0.01em;
    }

    /* Icon wrappers */
    #lab-locations-{{ section.id }} .lab-icon-wrapper {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: #111111;
      padding: 6px;
    }

    #lab-locations-{{ section.id }} .lab-icon-wrapper--main {
      padding: 7px;
    }

    #lab-locations-{{ section.id }} .lab-icon-wrapper--sub {
      background: #222222;
    }

    #lab-locations-{{ section.id }} .lab-icon-wrapper--small {
      background: #f0f0f0;
    }

    #lab-locations-{{ section.id }} .lab-icon {
      width: 16px;
      height: 16px;
      fill: currentColor;
      color: #ffffff;
    }

    #lab-locations-{{ section.id }} .lab-icon-wrapper--small .lab-icon {
      color: #111111;
    }

    /* MAIN CARD */
    #lab-locations-{{ section.id }} .lab-locations__main-card {
      background: #ffffff;
      border-radius: 14px;
              box-shadow: 10px 12px 0 #FEC340, 6px 6px 14px #FEC340;
      padding: 22px 20px 24px;
      margin-bottom: 40px;
    }

    #lab-locations-{{ section.id }} .lab-locations__main-inner {
          display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: anchor-center;
        gap: 22px;
    }

    .lab-main-info-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .lab-main-info-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .lab-main-info-content {
      flex: 1 1 0;
    }

    .lab-main-info-title {
      margin: 0 0 2px;
      font-size: 14px;
    }

    .lab-main-info-text p {
      margin: 0 0 4px;
      font-size: 14px;
      line-height: 1.5;
    }

    /* Map (main) */
    #lab-locations-{{ section.id }} .lab-locations__main-map {
      flex: 1 1 0;
    }

    #lab-locations-{{ section.id }} .lab-locations__map-embed {
      position: relative;
      width: 100%;
      padding-top: 60%;
      border-radius: 12px;
      overflow: hidden;
      background: #f1f1f1;
    }

    #lab-locations-{{ section.id }} .lab-locations__map-embed iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    /* SUB LOCATIONS */
    #lab-locations-{{ section.id }} .lab-locations__subheader-row {
      margin-bottom: 16px;
      margin-top: 4px;
    }

    #lab-locations-{{ section.id }} .lab-locations__subheading-wrap {
      display: inline-flex;
      gap: 8px;
      align-items: center;
    }

    #lab-locations-{{ section.id }} .lab-locations__subheading {
      margin: 0;
      font-size: 20px;
    }

    #lab-locations-{{ section.id }} .lab-locations__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }

    #lab-locations-{{ section.id }} .lab-location-card {
      background: #ffffff;
      border-radius: 12px;
      padding: 16px 16px 18px;
      box-shadow: 10px 12px 0 #FEC340, 6px 6px 14px #FEC340;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }

    #lab-locations-{{ section.id }} .lab-location-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.06);
    }

    #lab-locations-{{ section.id }} .lab-location-card__header {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    #lab-locations-{{ section.id }} .lab-location-card__title {
      font-size: 16px;
      margin: 0;
    }

    #lab-locations-{{ section.id }} .lab-location-card__description p {
      margin: 0 0 6px;
      font-size: 14px;
      line-height: 1.5;
    }

    #lab-locations-{{ section.id }} .lab-location-card__map {
      position: relative;
      width: 100%;
      padding-top: 60%;
      border-radius: 10px;
      overflow: hidden;
      background: #f3f3f3;
    }

    #lab-locations-{{ section.id }} .lab-location-card__map iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    /* TABLET */
    @media screen and (min-width: 750px) {
      #lab-locations-{{ section.id }} .lab-locations__main-card {
        padding: 24px 24px 28px;
      }

      .lab-main-info-title {
        font-size: 15px;
      }

      .lab-main-info-text p {
        font-size: 15px;
      }

      #lab-locations-{{ section.id }} .lab-locations__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    /* DESKTOP */
    @media screen and (min-width: 990px) {
      #lab-locations-{{ section.id }} .lab-locations__main-card {
        padding: 30px 32px 34px;
      }

      #lab-locations-{{ section.id }} .lab-locations__heading {
        font-size: 30px;
      }

      #lab-locations-{{ section.id }} .lab-locations__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

    }
    @media screen and (max-width: 767px) {
      #lab-locations-{{ section.id }} .lab-locations__main-inner {
            grid-template-columns: 1fr;
        }
    }
  {% endstyle %}
</section>

{% schema %}
{
  "name": "Lab locations & dropboxes",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main heading",
      "default": "Lab Reception & Main Location"
    },
    {
      "type": "richtext",
      "id": "main_address",
      "label": "Address",
      "default": "<p>We\u2019re at Level 1, 501 Crown Street, Surry Hills\u2014above Title Bookstore. Enter through the shop and head upstairs.</p>"
    },
    {
      "type": "richtext",
      "id": "lab_reception",
      "label": "Lab Reception",
      "default": "<p>Drop off film or pick up negatives with our friendly team: Mon\u2013Sat | 11am\u20134pm.</p>"
    },
    {
      "type": "richtext",
      "id": "film_dropoff",
      "label": "Film Drop-Off (After-hours)",
      "default": "<p>Lab-door dropbox: 7 days | 11am\u20135:30pm<br>Street-level dropbox: 24/7<br>More dropbox locations around Sydney\u2014see site for details.</p>"
    },
    {
      "type": "richtext",
      "id": "negative_collection",
      "label": "Negative Collection",
      "default": "<p>Lab-door negative pick-up (from secure boxes, by appointment): 7 days | 11am\u20135:30pm.</p>"
    },
    {
      "type": "textarea",
      "id": "main_map_iframe",
      "label": "Main location map iframe",
      "info": "Paste the Google Maps embed iframe for 501 Crown Street.",
      "default": "<iframe src=\"https://www.google.com/maps/embed?pb=\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\"></iframe>"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub-locations heading",
      "default": "More dropbox locations around Sydney"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#f7f7f7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "sublocation",
      "name": "Sub location",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Location name",
          "default": "Newtown dropbox"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Inside XYZ camera store. Film drop-off during store hours.</p>"
        },
        {
          "type": "textarea",
          "id": "map_iframe",
          "label": "Google Maps iframe",
          "info": "Paste the embed iframe for this dropbox location.",
          "default": "<iframe src=\"https://www.google.com/maps/embed?pb=\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\"></iframe>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Lab locations & dropboxes",
      "category": "Custom"
    }
  ]
}
{% endschema %}
