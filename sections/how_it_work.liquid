<section class="how-it-works {% if section.settings.full_width %}full-width{% endif %}" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="container">
    <h2 class="how-title">{{ section.settings.heading }}</h2>

    <div class="how-grid">
      {% for block in section.blocks %}
        <div class="how-card">
          {% if block.settings.icon != blank %}
            <div class="icon-wrapper" style="background: {{ block.settings.block_icon }};">
              <img src="{{ block.settings.icon | img_url: '100x100' }}" width="auto" height="auto" alt="" loading="lazy">
            </div>
          {% endif %}
          <div class="title_how_card">{{ block.settings.title }}</div>
          <div class="desp_how_card">{{ block.settings.text }}</div>
          {%  if block.settings.btn_link %}
            <a class="btn block-btn" href="{{ block.settings.btn_link }}">{{ block.settings.btn_text }}</a>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank %}
      <div class="how-button">
        <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_text }}</a>
      </div>
    {% endif %}
  </div>
</section>

<style>
section.how-it-works.full-width {
    margin: 0;
    border-radius: 0;
}
.how-it-works {
  margin: 60px 15px;
  padding: 40px 20px;
  border-radius: 20px;
}
.how-it-works .container {
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}
.how-it-works .how-title {
  font-size: 32px;
  margin: 0 auto 40px;
  color: #fff;
}
.how-it-works .how-grid {
  display: flex;
  flex-wrap: wrap;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}
.how-it-works .how-card {
  background: #F26531;
  padding: 20px;
  text-align: center;
  flex: 1 1 23%;
  padding-bottom: 60px !important;
  position: relative;
}
a.btn.block-btn {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
}
.how-it-works .icon-wrapper {
  width: 100px;
  height: 100px;
  padding: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50%;
  margin: 0 auto 15px;
}
.icon-wrapper img {
    width: 100%;
    height: 100%;
}
.title_how_card {
  font-size: 20px;
  margin: 0 auto 10px;
  color: #fff;
  line-height: normal;
}
.desp_how_card {
  font-size: 12px;
  line-height: normal;
  color: #fff;
}
.desp_how_card a{
  font-size: 12px;
  font-weight: bold;
  line-height: normal;
  color: #fff;
}
.how-it-works .how-button {
  margin-top: 40px;
}
.how-it-works .btn {
  background: #000;
  color: #fff;
  padding: 7px 20px;
  border-radius: 4px;
  line-height: normal;
  text-decoration: none;
  transition: 0.3s ease;
      font-size: 14px;
}

@media (max-width: 925px) {
  .how-it-works .how-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .how-it-works .how-card {
    flex: 1 1 47%;
  }
}
@media (max-width: 576px) {
  .how-it-works .how-card {
    flex: 1 1 50%;
  }
  .how-it-works {
    padding: 40px 15px;
    margin: 30px 15px;
  }
  .film-image {
    margin: 35px 0;
}
  .how-it-works .how-grid {
    gap: 15px;
}
.how-it-works .how-card {
    padding: 0 0px;
}
}
</style>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make it full width",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "How it works"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F26531"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "DEVELOP & SCAN"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Step Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "color",
          "id": "block_icon",
          "label": "Icon Background Color"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "Your Film, Our Craft"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Card Description"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Label",
          "default": "Learn More"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "How It Works",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "title": "Your Film, Our Craft"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Fast, Without the Rush"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Your Lab, Your Way"
          }
        },
        {
          "type": "card",
          "settings": {
            "title": "Drop In, Or Drop Off"
          }
        }
      ]
    }
  ]
}
{% endschema %}
