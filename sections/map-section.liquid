<section 
  class="contact-map-section"
  id="contact-map-section"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width contact-map-wrapper">
    
    {% if section.settings.heading != blank %}
      <h2 class="contact-map-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="contact-map-subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="contact-map-grid">

      <div class="contact-map-info">
        {% if section.settings.address_title != blank %}
          <h3 class="contact-map-title">{{ section.settings.address_title }}</h3>
        {% endif %}

        {% if section.settings.address_text != blank %}
          <p class="contact-map-text">{{ section.settings.address_text }}</p>
        {% endif %}

        {% if section.settings.phone != blank %}
          <p class="contact-map-phone contact-icon-row">
            <span class="icon-svg">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M22 17.01V21a1 1 0 0 1-1.09 1A19.91 19.91 0 0 1 3 4.09 1 1 0 0 1 4 3h4a1 1 0 0 1 1 0.78 12.45 12.45 0 0 0 .7 2.21A1 1 0 0 1 9.35 7L7.62 8.73a16 16 0 0 0 7.65 7.65L17 14.65a1 1 0 0 1 1-.25 12.45 12.45 0 0 0 2.21.7A1 1 0 0 1 22 17.01z" fill="currentColor"/>
              </svg>
            </span>
            <a href="tel:{{ section.settings.phone }}">{{ section.settings.phone }}</a>
          </p>
        {% endif %}

        {% if section.settings.email != blank %}
          <p class="contact-map-email contact-icon-row">
            <span class="icon-svg">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M4 4h16a2 2 0 0 1 2 2v.4l-10 6-10-6V6a2 2 0 0 1 2-2zm18 4.2v9.8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.2l10 6 10-6z" fill="currentColor"/>
              </svg>
            </span>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </p>
        {% endif %}

        <!-- Dynamic Lab Reception Info -->
        {% if section.settings.lab_reception_title != blank %}
          <div class="contact-lab-info">
            <h4 class="lab-info-title">{{ section.settings.lab_reception_title }}</h4>
            {% if section.settings.lab_reception_text != blank %}
              <p class="lab-info-text">{{ section.settings.lab_reception_text }}</p>
            {% endif %}

            {% if section.settings.after_hours_title != blank %}
              <h4 class="lab-info-title">{{ section.settings.after_hours_title }}</h4>
            {% endif %}

            {% if section.settings.film_dropoff != blank %}
              <p class="lab-info-text"><br>{{ section.settings.film_dropoff }}</p>
            {% endif %}

            {% if section.settings.negative_collection != blank %}
              <p class="lab-info-text"><strong>Negative Collection:</strong><br>{{ section.settings.negative_collection }}</p>
            {% endif %}
          </div>
        {% endif %}

      </div>

      <div class="contact-map-frame">
        {% if section.settings.map_iframe != blank %}
          {{ section.settings.map_iframe }}
        {% else %}
          <div class="map-placeholder">Add your map iframe in the section settings.</div>
        {% endif %}
      </div>

    </div>

  </div>
</section>

<style>
  .contact-map-heading {
    text-align: center;
    font-size: 32px;
    margin-bottom: 10px;
    font-weight: 600;
  }
  .contact-map-subheading {
    text-align: center;
    font-size: 16px;
    margin-bottom: 40px;
    color: #555;
  }
  .contact-map-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 40px;
    align-items: start;
  }
  .contact-map-info h3 {
    margin-bottom: 10px;
    font-size: 22px;
    font-weight: 600;
  }
  .contact-map-text,
  .contact-map-phone,
  .contact-map-email {
    font-size: 15px;
    color: #333;
    margin-bottom: 12px;
  }
  .contact-map-info a {
    text-decoration: none;
    color: inherit;
  }

  .contact-icon-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .icon-svg {
    display: flex;
    align-items: center;
    color: #444;
  }

  .contact-map-frame iframe {
    width: 100%;
    height: 350px;
    border: 0;
    border-radius: 10px;
  }
  .map-placeholder {
    background: #f5f5f5;
    padding: 40px;
    text-align: center;
    border-radius: 10px;
  }

  /* Lab info styling */
  .contact-lab-info {
    margin-top: 25px;
  }
  .contact-lab-info .lab-info-title {
    font-size: 18px;
    margin-bottom: 6px;
  }
  .contact-lab-info .lab-info-text {
    font-size: 14px;
    color: #333;
    margin-bottom: 15px;
    line-height: 1.5;
  }
  .contact-lab-info a {
    color: #0073e6;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .contact-map-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .contact-map-heading {
      font-size: 26px;
    }
    .contact-map-subheading {
      font-size: 14px;
      margin-bottom: 25px;
    }
    .contact-map-frame iframe {
      height: 280px;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Map Section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We’re here to help you anytime."
    },
    {
      "type": "text",
      "id": "address_title",
      "label": "Address Title",
      "default": "Our Location"
    },
    {
      "type": "textarea",
      "id": "address_text",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address"
    },
    {
      "type": "textarea",
      "id": "map_iframe",
      "label": "Map Embed Iframe"
    },
    {
      "type": "text",
      "id": "lab_reception_title",
      "label": "Lab Reception Title",
      "default": "Lab Reception"
    },
    {
      "type": "textarea",
      "id": "lab_reception_text",
      "label": "Lab Reception Text",
      "default": "Drop off film or pick up negatives with our friendly team: Mon–Sat | 11 am–4 pm"
    },
    {
      "type": "text",
      "id": "after_hours_title",
      "label": "After-Hours Service Title",
      "default": "After-Hours Service"
    },
    {
      "type": "richtext",
      "id": "film_dropoff",
      "label": "Film Drop-Off Details",
      "default": "<p>Lab-door dropbox: 7 days | 11 am–5:30 pm\nStreet-level dropbox: 24/7\nMore dropbox locations around Sydney—see [here] for details.</p>"
    },
    {
      "type": "textarea",
      "id": "negative_collection",
      "label": "Negative Collection Details",
      "default": "Lab-door Negative pick-up (from secure boxes, by appointment): 7 days | 11 am–5:30 pm"
    }
  ],
  "presets": [
    {
      "name": "Contact Map"
    }
  ]
}
{% endschema %}
