<style>
    .main--section--pricelist--wraper.{{ section.id }} {
    padding-top:{{ section.settings.padding_top }}px;
    padding-bottom:{{ section.settings.padding_bottom }}px;
    }

    .main__price--list--inner img{
        width:100%;
    }

    @media screen and (max-width: 768px){
    .main--section--pricelist--wrapper.{{ section.id }} {
        padding-top:{{ section.settings.padding_top }}px;
        padding-bottom:{{ section.settings.padding_bottom }}px;
    }
    
    }
</style>

<div class="main--section--pricelist--wraper {{ section.id }}">
    <div class="main__price--list--inner">
        <img style="display:block;" src="{{ section.settings.section_image | image_url }}">
    </div>
</div>


{% schema %}

{
  "name": "price-list",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "image_picker",
      "id": "section_image",
      "label": "Section Image"
    }
  ],
  "presets": [
    {
      "name": "price-list"
    }
  ]
}
{% endschema %}