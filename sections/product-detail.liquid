<div
  style="
    background: {{ section.settings.bg_color }};
    position: relative;
    overflow: hidden;
    padding-top: {{ section.settings.top_spacing }}px;
    padding-bottom: {{ section.settings.bottom_spacing }}px;
  "
>
  <div class="page-width">
    <div id="product-details-gold" class="product-details-section">
      {% for block in section.blocks %}
        {% if block.type == 'badge' %}
          <div
            class="
              floating-badge
              {% if block.settings.badge_style == 'burst' %}badge-burst{% else %}badge-cloud{% endif %}
            "
            style="
              top: {{ block.settings.top_position }}%;
              left: {{ block.settings.left_position }}%;
            "
          >
            {% if block.settings.icon_image != blank %}
              <img src="{{ block.settings.icon_image | img_url: '180x' }}">
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

      <h2 class="pd-section-title">{{ section.settings.title }}</h2>

      <div class="product-details-grid">
        <div class="pd-left">
          <div class="features">
            {% for block in section.blocks %}
              {% if block.type == 'feature' %}
                <div class="feature-card">
                  <div class="icon-circle" style="background: {{ block.settings.icon_color }};">
                    {% if block.settings.icon_type == 'text' %}
                      {{ block.settings.icon_text }}

                    {% elsif block.settings.icon_type == 'svg' %}
                      <div class="svg-icon">
                        {{ block.settings.icon_svg }}
                      </div>

                    {% elsif block.settings.icon_type == 'image' and block.settings.icon_image != blank %}
                      <img src="{{ block.settings.icon_image | img_url: '80x' }}" style="width:32px; height:32px;">
                    {% endif %}
                  </div>

                  <div class="feature-content">
                    <h4>{{ block.settings.heading }}</h4>
                    <p>{{ block.settings.text }}</p>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          {% if section.settings.quote_text != blank %}
            <div class="quote">{{ section.settings.quote_text }}</div>
          {% endif %}
        </div>
        <aside class="specs">
          <h3 class="specs-title">{{ section.settings.specs_title }}</h3>

          {% for block in section.blocks %}
            {% if block.type == 'spec' %}
              <div class="spec-row">
                <span class="spec-label">{{ block.settings.label }}</span>
                <span class="spec-value">{{ block.settings.value }}</span>
              </div>
            {% endif %}
          {% endfor %}

          {% if section.blocks.size > 0 %}
            <h4 class="sample-title">{{ section.settings.sample_title }}</h4>
            <div class="samples">
              {% for block in section.blocks %}
                {% if block.type == 'sample' %}
                  <div
                    class="sample"
                    style="background-image:url('{{ block.settings.sample_image | img_url: '800x' }}')"
                  ></div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </aside>
      </div>
    </div>
  </div>
  {% if section.settings.show_bottom_marquee %}
    <div class="bottom-marquee">
      <div class="marquee-track">
        {% for i in (1..100) %}
          <div class="marquee-logos"></div>
        {% endfor %}
        {% for i in (1..100) %}
          <div class="marquee-logos"></div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

<style>
    .product-details-section {
      background: transparent;
      position: relative;
    }

    h2.pd-section-title {
      font-size: clamp(26px, 4vw, 42px);
      margin-bottom: 30px;
    }

    .floating-badge {
      position: absolute;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      font-weight: 700;
      font-size: 20px;
      padding: 10px;
      z-index: 1;
      animation: float 6s ease-in-out infinite;
    }


    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
    }

    .product-details-grid {
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: 40px;
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }

    .feature-card {
      display: flex;
      gap: 16px;
      padding: 20px;
      background: #fff;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(0,0,0,0.12);
    }

    .icon-circle {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      color: white;
      font-weight: 700;
      font-size: 16px;
      flex-shrink: 0;
    }

    .svg-icon svg {
      width: 32px;
      height: 32px;
      fill: currentColor;
    }

    .feature-content h4 {
      font-size: 22px;
      margin: 0;
      line-height: 1.2;
    }

    .feature-content p {
      font-size: 16px;
      line-height: 1.4;
      margin: 4px 0 0;
    }

    .quote {
      margin-top: 30px;
      padding: 22px;
      border-radius: 12px;
      background: rgba(254,195,64,0.1);
      font-family: "Playfair Display", serif;
      font-size: 18px;
      font-style: italic;
      border-left: 6px solid #FEC340;
    }

    .specs {
      background: #fff;
      border-radius: 12px;
      padding: 20px;
      border: 1px solid rgba(0,0,0,0.05);
      box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .specs-title {
      font-family: "Oswald", sans-serif;
      font-size: 20px;
      margin-bottom: 16px;
    }

    .spec-row {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-top: 1px dashed rgba(0,0,0,0.08);
    }

    .spec-row:first-of-type {
      border-top: none;
    }

    .spec-label {
      font-weight: 600;
      color: #555;
    }

    .spec-value {
      font-weight: 400;
      color: #222;
    }

    .sample-title {
      margin-top: 24px;
      font-weight: 700;
      font-size: 14px;
      color: #333;
    }

    .samples {
      margin-top: 14px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .sample {
      width: calc(33.33% - 8px);
      min-width: 110px;
      aspect-ratio: 1.4/1;
      border-radius: 10px;
      background-size: cover;
      background-position: center;
      box-shadow: 0 8px 26px rgba(0,0,0,0.08);
      transition: transform 0.3s ease;
    }

    .sample:hover {
      transform: scale(1.05);
    }

    @media (max-width: 1024px) {
      .product-details-grid {
        grid-template-columns: 1fr;
      }
      .samples {
        justify-content: center;
      }
    }
    @media screen and (max-width:767px){
        .floating-badge {
            display: none;
        }
    }

  .bottom-marquee {
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
    white-space: nowrap;
        padding-top: 50px;
  }

  .marquee-track {
    display: flex;
    gap: 10px;
    animation: marquee-logos 100s linear infinite;
  }

  .marquee-logos {
    display: block !important;
    width: 25px;
    height: 14px;
    border-radius: 5px;
    background: #fff;
  }

  @keyframes marquee-logos {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>

{% schema %}
{
  "name": "Product Details",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#FEC340" },

    {
      "type": "range",
      "id": "top_spacing",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Top Spacing",
      "default": 80
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Bottom Spacing",
      "default": 80
    },

    { "type": "text", "id": "title", "label": "Section title", "default": "Why shoot Kodak Gold 200" },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote text",
      "default": "“Shooting with analog photography sharpens your eye.” — Live Forever Film Lab"
    },

    { "type": "text", "id": "specs_title", "label": "Specs title", "default": "Technical specs" },
    { "type": "text", "id": "sample_title", "label": "Sample gallery title", "default": "Sample gallery" },
    {
      "type": "header",
      "content": "Bottom Logos Marquee"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_marquee",
      "label": "Show bottom marquee",
      "default": true
    }
  ],

  "blocks": [
    {
      "type": "badge",
      "name": "Floating Badge",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon Image" },
        {
          "type": "range",
          "id": "top_position",
          "min": 0,
          "max": 90,
          "step": 1,
          "unit": "%",
          "label": "Top Position",
          "default": 20
        },
        {
          "type": "range",
          "id": "left_position",
          "min": 0,
          "max": 90,
          "step": 1,
          "unit": "%",
          "label": "Left Position",
          "default": 10
        }
      ]
    },

    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon Type",
          "default": "text",
          "options": [
            { "value": "text", "label": "Text Icon" },
            { "value": "svg", "label": "SVG Icon (paste code)" },
            { "value": "image", "label": "Image Icon" }
          ]
        },

        { "type": "text", "id": "icon_text", "label": "Icon Text", "default": "G" },
        { "type": "textarea", "id": "icon_svg", "label": "SVG Code (paste full <svg>…</svg>)" },
        { "type": "image_picker", "id": "icon_image", "label": "Icon Image" },

        { "type": "color", "id": "icon_color", "label": "Icon background color", "default": "#EF4130" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fine Grain & High Sharpness" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Clean grain & sharp rendering." }
      ]
    },

    {
      "type": "spec",
      "name": "Specification",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Film Type" },
        { "type": "text", "id": "value", "label": "Value", "default": "35mm Colour Negative" }
      ]
    },

    {
      "type": "sample",
      "name": "Sample Image",
      "settings": [{ "type": "image_picker", "id": "sample_image", "label": "Sample image" }]
    }
  ],

  "presets": [{ "name": "Product Details", "category": "Product" }]
}
{% endschema %}
