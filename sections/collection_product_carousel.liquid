<section
  id="whats-on-shelf"
  class="whats-on-shelf-main"
  style="
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  "
>
  <div class="container-shelf">
    <div class="header-row-{{ section.id }}">
      <div class="header-text-{{ section.id }}">
        <h2 style="font-size: {{ section.settings.heading_size }}px">{{ section.settings.heading }}</h2>
        <p style="font-size: {{ section.settings.subheading_size }}px">{{ section.settings.subheading }}</p>
      </div>
      <div class="header-controls">
        <a href="{{ section.settings.view_all_url }}" class="view-all">{{ section.settings.view_all_label }}</a>
        <div class="nav-buttons-{{ section.id }}">
          {% comment %} <button class="button-prev-{{ section.id }}" style="color: {{ section.settings.text_color }}; border: 1px solid {{ section.settings.text_color }};">
            <svg viewBox="-19.04 0 75.803 75.803" xmlns="http://www.w3.org/2000/svg" fill="#000000"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g id="Group_64" data-name="Group 64" transform="translate(-624.082 -383.588)"> <path id="Path_56" data-name="Path 56" d="M660.313,383.588a1.5,1.5,0,0,1,1.06,2.561l-33.556,33.56a2.528,2.528,0,0,0,0,3.564l33.556,33.558a1.5,1.5,0,0,1-2.121,2.121L625.7,425.394a5.527,5.527,0,0,1,0-7.807l33.556-33.559A1.5,1.5,0,0,1,660.313,383.588Z" fill="#000"></path> </g> </g></svg>
          </button> {% endcomment %}
          <div class="button-prev-{{ section.id }}">
            <img src="https://cdn.shopify.com/s/files/1/0949/0576/2156/files/Group_47.png?v=1762885714" width="30" height="30">
          </div>
          <div class="button-next-{{ section.id }}">
            <img src="https://cdn.shopify.com/s/files/1/0949/0576/2156/files/Group_48.png?v=1762885714" width="30" height="30">
          </div>
          {% comment %} <button class="button-next-{{ section.id }}" style="color: {{ section.settings.text_color }}; border: 1px solid {{ section.settings.text_color }};">
            <svg viewBox="-19.04 0 75.803 75.803" xmlns="http://www.w3.org/2000/svg" fill="#000000" transform="rotate(180)"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g id="Group_64" data-name="Group 64" transform="translate(-624.082 -383.588)"> <path id="Path_56" data-name="Path 56" d="M660.313,383.588a1.5,1.5,0,0,1,1.06,2.561l-33.556,33.56a2.528,2.528,0,0,0,0,3.564l33.556,33.558a1.5,1.5,0,0,1-2.121,2.121L625.7,425.394a5.527,5.527,0,0,1,0-7.807l33.556-33.559A1.5,1.5,0,0,1,660.313,383.588Z" fill="#000"></path> </g> </g></svg>
          </button> {% endcomment %}
        </div>
      </div>
    </div>

    <div class="whats-on-shelf">
      <div class="whats-on-shelf-container-{{ section.id }}">
        {% assign collection = collections[section.settings.collection] %}

        {% if section.settings.productslist != blank %}
          {% for product in section.settings.productslist %}
              <div class="product-card-shelf">
              <div class="card-inner">
                  <a href="{{ product.url }}" class="product-image">
                      <div class="product-image-shelf" style="background: {{ section.settings.card_bg }};">
                        <div class="only_img_size">
                          <img
                              src="{{ product.featured_image | img_url: 'master' }}"
                              alt="{{ product.title }}"
                              loading="lazy"
                              width="auto"
                              height="auto"
                          >
                        </div>
                        {% unless product.available %}
                            <div class="sold_badge_g">Sale Out</div>
                        {% endunless %}
                        <div class="badges_products">
                           {% assign tags = product.tags | join: ',' | downcase %}

                            {% if tags contains 'new' and product.available %}
                              <div class="new">New</div>
                            {% endif %}

                            {% if tags contains 'best selling' and product.available %}
                              <div class="bestseller">Best Selling</div>
                            {% endif %}
                        </div>
                      </div>
                  </a>
                  <div class="product-info">
                  <div class="price-size-row">
                      <span class="price">{{ product.price | money }}</span>
                      <span class="size">{{ product.selected_or_first_available_variant.title }}</span>
                  </div>
                  <p class="product-title">{{ product.title }}</p>
                  </div>
              </div>
              </div>
            {% endfor %}
        {% elsif section.settings.collection != blank %}
        {% for product in collection.products %}
            <div class="product-card-shelf">
              <div class="card-inner">
                  <a href="{{ product.url }}" class="product-image">
                      <div class="product-image-shelf" style="background: {{ section.settings.card_bg }};">
                        <div class="only_img_size">
                          <img
                              src="{{ product.featured_image | img_url: 'master' }}"
                              alt="{{ product.title }}"
                              loading="lazy"
                              width="auto"
                              height="auto"
                          >
                        </div>
                        {% unless product.available %}
                            <div class="sold_badge_g">Sale Out</div>
                        {% endunless %}
                        <div class="badges_products">
                           {% assign tags = product.tags | join: ',' | downcase %}

                            {% if tags contains 'new' and product.available %}
                              <div class="new">New</div>
                            {% endif %}

                            {% if tags contains 'best selling' and product.available %}
                              <div class="bestseller">Best Selling</div>
                            {% endif %}
                        </div>
                      </div>
                  </a>
                  <div class="product-info">
                  <div class="price-size-row">
                      <span class="price">{{ product.price | money }}</span>
                      <span class="size">{{ product.selected_or_first_available_variant.title }}</span>
                  </div>
                  <p class="product-title">{{ product.title }}</p>
                  </div>
              </div>
            </div>
        {% endfor %}
        {% else %}
          {% for i in (1..5) %}
            <div class="product-card-shelf">
              <div class="card-inner">
                  <a href="#" class="product-image">
                      <div class="product-image-shelf" style="background: {{ section.settings.card_bg }};">
                        <div class="only_img_size">
                          <img
                                src="https://cdn.shopify.com/s/files/1/0731/1900/6857/files/product_image.png?v=1762190799"
                                alt="Product Image"
                                loading="lazy"
                                width="auto"
                                height="auto"
                            >
                          </div>
                        <div class="badges_products">
                          <div class="bestseller">Best Selling</div>
                        </div>
                      </div>
                  </a>
                  <div class="product-info">
                  <div class="price-size-row">
                      <span class="price">$210 USD</span>
                      <span class="size">120mm</span>
                  </div>
                  <p class="product-title">Product Title</p>
                  </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

  <style>
    .whats-on-shelf-main {
      font-family: inherit;
        margin: 40px 5px 0;
        padding: 0px 0 70px;
    }
    .whats-on-shelf .container {
      margin: auto;
    }
    .header-row-{{ section.id }} {
        display: flex;
        justify-content: space-between;
        align-items: {{ section.settings.alignment }};
        padding: 15px 60px 40px;
        width: 90%;
        margin: 0 auto;
    }
    .header-text-{{ section.id }} h2 {
      margin: 0;
      max-width: 435px;
    }
    .header-text-{{ section.id }} p {
      margin: 0.25rem 0 0;
      opacity: 0.8;
    }
    .header-controls {
      display: flex;
      align-items: center;
      gap: 5rem;
    }
    .view-all {
      text-decoration: none;
      font-size: 14px;
      color: #fff;
      background: #F26531;
      padding: 2px 12px;
      border-radius: 6px;
        white-space: nowrap;
    }
    .nav-buttons-{{ section.id }} button {
      background: transparent;
      border-radius: 50%;
      width: 25px;
      height: 25px;
      cursor: pointer;
      font-size: 2rem;
    }
    .button-prev-{{ section.id }} ,
    .button-next-{{ section.id }} {
      display: flex;
      cursor: pointer;
    }
    .product-card-shelf {
        width: 33.333%;
        padding: 0 5px;
    }
    .product-image-shelf {
        border-radius: 16px;
        padding: 1rem;
        text-align: center;
        aspect-ratio: 1/1;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }
    .only_img_size {
      margin-bottom: 1rem;
      width: 75%;
      height: 50%;
    }
    .only_img_size img {
      border-radius: 12px;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .sold_badge_g {
        position: absolute;
        bottom: 15px;
        left: 15px;
        background: #db9108;
        color: #fff;
        border-radius: 30px;
        padding: 0 10px;
        font-size: 14px;
    }
    .new,
    .bestseller{
        background: #fff;
        color: #000;
        border-radius: 30px;
        padding: 0 10px;
        font-size: 14px;
    }
    .badges_products{
        position: absolute;
        bottom: 15px;
        left: 15px;
        display: flex;
        gap: 8px;
        align-items: center;
        width: 100%;
    }
    .price-size-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
    .card-inner .price {
      font-size: 12px;
    }
    .card-inner .size {
        border: 1px solid currentColor;
        padding: 1px 15px;
        border-radius: 8px;
        font-size: 0.85em;
    }
    .card-inner .product-title {
      font-size: 14px;
      margin: 0;
    }
    .card-inner .product-info {
        padding: 12px;
    }
    .whats-on-shelf-container-{{ section.id }} .flickity-page-dots {
        flex-wrap: nowrap;
        display: flex;
        position: absolute;
        width: 90%;
        bottom: -25px;
        padding: 0;
        margin: 0;
        list-style: none;
        text-align: center;
        line-height: 1;
        left: 48%;
        transform: translateX(-50%);
    }
    .nav-buttons-{{ section.id }}{
        display: flex;
        gap: 10px;
    }
    .whats-on-shelf-container-{{ section.id }} .flickity-page-dots .dot {
        width: 100%;
        height: 3px;
        margin: 0;
        border-radius: 0;
    }
    .whats-on-shelf-container-{{ section.id }} .flickity-page-dots .dot:first-child {
        border-radius: 10px 0 0 10px;
    }
    .whats-on-shelf-container-{{ section.id }} .flickity-page-dots .dot:last-child {
        border-radius: 0 10px 10px 0;
    }
    .whats-on-shelf-container-{{ section.id }} .flickity-prev-next-button {
        top: -10%;
        width: 30px;
        height: 30px;
        opacity: 0 !important;
    }
    .whats-on-shelf-container-{{ section.id }} .flickity-prev-next-button.previous {
        left: auto;
        right: 173px;
    }
    .whats-on-shelf-container-{{ section.id }} .flickity-prev-next-button.next {
        right: 132px;
    }
    @media (max-width: 999px) {
        .product-card-shelf {
            width: 50%;
        }
        .header-row-{{ section.id }} {
            padding: 15px 0px 40px;
        }
        .header-controls {
            gap: 2rem;
        }
    }

    @media (max-width: 600px) {
        .product-card-shelf {
            width: 100%;
        }
        .header-controls{
            flex-direction: column;
            gap: 1rem;
        }
        .header-row-{{ section.id }} {
            padding: 15px 0px 20px;
        }
        .whats-on-shelf-main {
            margin: 40px 15px 0;
            padding: 0px 0 50px;
        }
        .header-text-{{ section.id }} h2{
            font-size: 20px !important;
        }
        .header-text-{{ section.id }} p{
            font-size: 12px !important;
        }
    }
  </style>


<link rel="stylesheet" href="https://unpkg.com/flickity@2/dist/flickity.min.css">
<script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js"></script>


<script>
    document.addEventListener("DOMContentLoaded", function () {
    const sliderElem = document.querySelector('.whats-on-shelf-container-{{ section.id }}');
    if (!sliderElem) return;

    const flkty = new Flickity(sliderElem, {
        cellAlign: 'left',
        groupCells: true,
        contain: true,
        pageDots: true,
        prevNextButtons: false,
        wrapAround: false,
        draggable: true
    });

    const prevBtn = document.querySelector('.button-prev-{{ section.id }}');
    const nextBtn = document.querySelector('.button-next-{{ section.id }}');

    if (prevBtn) prevBtn.addEventListener('click', () => flkty.previous());
    if (nextBtn) nextBtn.addEventListener('click', () => flkty.next());

    let wheelTimer;
    sliderElem.addEventListener(
        'wheel',
        function (e) {
        if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
        if (wheelTimer) return;
        if (e.deltaX > 0) flkty.next();
        else flkty.previous();
        wheelTimer = setTimeout(() => (wheelTimer = null), 300);
        },
        { passive: true }
    );
    });
</script>


{% schema %}
{
  "name": "What's on the Shelf",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's on the Shelf"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Hand-picked rolls and lab essentials for every photographer"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "product_list",
      "id": "productslist",
      "label": "Select Products (optional)",
      "info": "If selected, these products will show instead of the collection."
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All URL"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Button Text",
      "default": "VIEW ALL"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Vertical Alignment",
      "default": "flex-end",
      "options": [
        {
          "label": "Top",
          "value": "flex-start"
        },
        {
          "label": "Cenetr",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "flex-end"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffaf0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#F0EAD8"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "default": 28,
      "min": 16,
      "max": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading Font Size",
      "default": 16,
      "min": 12,
      "max": 24,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "What's on the Shelf"
    }
  ]
}
{% endschema %}