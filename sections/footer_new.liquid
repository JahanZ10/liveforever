<footer class="new_footer_main" 
    style="background-color: {{ section.settings.bg_color }};
    margin: {{ section.settings.section_margin }};
    padding: {{ section.settings.section_padding }};">

    <div class="newsletter_footer_main">
        <div class="footer-block__newsletter">
            {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="footer-block__heading-new">{{ section.settings.newsletter_heading }}</h2>
            {%- endif -%}
            {%- if section.settings.newsletter_subheading != blank -%}
            <p class="footer-block__subheading-new">{{ section.settings.newsletter_subheading }}</p>
            {%- endif -%}
            {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter-form__field-wrapper">
                    <div class="field">
                    <input
                        id="NewsletterForm--{{ section.id }}"
                        type="email"
                        name="contact[email]"
                        class="field__input"
                        value="{{ form.email }}"
                        aria-required="true"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
                        {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="ContactFooter-error"
                        {% elsif form.posted_successfully? %}
                        aria-describedby="ContactFooter-success"
                        {% endif %}
                        placeholder="{{ 'newsletter.label' | t }}"
                        required
                    >
                    <label class="field__label" for="NewsletterForm--{{ section.id }}">
                        {{ 'newsletter.label' | t }}
                    </label>
                    <button
                        type="submit"
                        class="newsletter-form__button field__button"
                        name="commit"
                        id="Subscribe"
                        aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                        <span class="svg-wrapper">
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </span>
                    </button>
                    </div>
                    {%- if form.errors -%}
                    <small class="newsletter-form__message form__message" id="ContactFooter-error">
                        <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                        </span>
                        {{- form.errors.translated_fields.email | capitalize }}
                        {{ form.errors.messages.email -}}
                    </small>
                    {%- endif -%}
                </div>
                {%- if form.posted_successfully? -%}
                    <h3
                    class="newsletter-form__message newsletter-form__message--success form__message"
                    id="ContactFooter-success"
                    tabindex="-1"
                    autofocus
                    >
                    <span class="svg-wrapper">
                        {{- 'icon-success.svg' | inline_asset_content -}}
                    </span>
                    {{- 'newsletter.success' | t }}
                    </h3>
                {%- endif -%}
            {%- endform -%}
        </div>
    </div>

    <div class="footer_content_main">
        <div class="footer_image">
            <img src="{{ section.settings.footer_image | img_url: "master" }}" width="auto" height="auto" alt="Footer Image">
        </div>
        <div class="footer_content_main_menu">
            {% for block in section.blocks %}
            <div class="footer_col">
                <div class="content_heading">{{ block.settings.heading }}</div>

                {% if block.type == 'text_block' %}
                <div class="footer_text">{{ block.settings.text | newline_to_br }}</div>
                {% elsif block.type == 'menu_block' %}
                <ul>
                    {% assign menu = linklists[block.settings.menu] %}
                    {% for link in menu.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {% endfor %}
                </ul>
                {% endif %}
            </div>
            {% endfor %}
        </div>

        <div class="footer_bottom">
            <div>&copy; {{ 'now' | date: '%Y' }}, {{ section.settings.copyright_text }}</div>
            <div>
            {% if section.settings.term_text != blank %}
                <a href="{{ section.settings.terms_url }}">{{ section.settings.term_text }}</a>
            {% endif %}
            {% if section.settings.privacy_text != blank %}
                <a href="{{ section.settings.privacy_url }}">{{ section.settings.privacy_text }}</a>
            {% endif %}
            </div>
        </div>
    </div>
</footer>


<style>
    .newsletter_footer_main{
        max-width: 450px;
        margin: 0 auto;
        text-align: center;
    }
    .newsletter_footer_main .field:after,
    .newsletter_footer_main .field:before,
    .newsletter_footer_main .field:hover.field:after,
    .newsletter_footer_main .field:hover.field:before,
    .newsletter_footer_main .field__input{
        border-radius: 10px;
    }
    .newsletter_footer_main .newsletter-form__button{
        border-radius: 50%;
        background-color: #000;
        height: 3rem;
        right: 10px;
        top: 9px;
        width: 3rem;
    }
    .newsletter_footer_main .newsletter-form__button svg{
        color: #fff;
        width: 16px;
    }
    .footer-block__heading-new{
        font-size: 44px;
        line-height: normal;
        margin: 0 0 10px;
    }
    .footer-block__subheading-new{
        font-size: 16px;
        line-height: normal;
        margin: 0 auto 30px;
        letter-spacing: 0;
        max-width: 400px;
    }
    .footer_content_main{
        background-color: #000;
        border-radius: 20px;
        padding: 4% 5% 2%;
        margin-top: 5%;
    }
    .footer_image{
        max-width: 650px;
        margin: 0 auto;
    }
    .footer_image img{
        width: 100%;
    }
    .footer_content_main_menu {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 40px;
        text-align: left;
        padding: 40px 0;
    }
    .footer_col .content_heading {
        font-size: 16px;
        color: #fbc02d;
        text-transform: uppercase;
        margin-bottom: 12px;
    }
    .footer_col p {
        font-size: 14px;
        line-height: normal;
        color: #aaa;
        margin: 0 0 10px 0;
    }
    .footer_col ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .footer_col ul li {
        margin-bottom: 5px;
        line-height: normal;
    }
    .footer_col ul li a {
        color: #aaa;
        text-decoration: none;
        transition: 0.3s;
    }
    .footer_col ul li a:hover {
        color: #fbc02d;
    }
    .footer_bottom {
        margin-top: 50px;
        padding-top: 20px;
        font-size: 12px;
        color: #aaa;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }
    .footer_bottom a {
        color: #aaa;
        text-decoration: none;
        margin-left: 10px;
    }
    @media screen and (max-width: 768px){
        .footer_bottom{
            margin-top: 0;
        }
    }
</style>


{% schema %}
{
  "name": "Footer New",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FEC340"
    },
    {
      "type": "text",
      "id": "section_padding",
      "label": "Inner Space",
      "default": "60px 20px 30px 20px"
    },
    {
      "type": "text",
      "id": "section_margin",
      "label": "Outer Space",
      "default": "60px 0px 0px"
    },
    {
        "type": "text",
        "id": "newsletter_heading",
        "label": "Newsletter Heading",
        "default": "Join the club"
    },
    {
        "type": "text",
        "id": "newsletter_subheading",
        "label": "Newsletter Sub Heading",
        "default": "Get updates on film tips, lab news and exclusive merch drop straight to your inbox"
    },
    {
        "type": "image_picker",
        "id": "footer_image",
        "label": "Select Image"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Live Forever Film Labs. All Rights Reserved."
    },
    {
      "type": "text",
      "id": "term_text",
      "label": "Terms Text",
      "default": "Terms & Conditions"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Terms & Conditions Link"
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Privacy Text",
      "default": "Privacy Policy"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy Policy Link"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "WHERE TO FIND US"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We're at 501 Crown Street, Surry Hills (above Title Bookstore)\nMon–Sat 11am–4 pm</p>"
        }
      ]
    },
    {
      "type": "menu_block",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "COMPANY"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer New"
    }
  ]
}
{% endschema %}