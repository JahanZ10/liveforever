    // Function to validate required fields in all film blocks
    function validateRequiredFields() {
      const errors = [];
      const filmBlocks = document.querySelectorAll('.film-block');
      
      filmBlocks.forEach((block, index) => {
        const typeEl = block.querySelector('[data-name="filmType"] .selected-text');
        const formatEl = block.querySelector('[data-name="filmFormat"] .selected-text');
        const scanSizeEl = block.querySelector('[data-name="filmscanSize"] .selected-text');
        
        const type = typeEl?.textContent.trim();
        const format = formatEl?.textContent.trim();
        const scanSize = scanSizeEl?.textContent.trim();
        
        // Remove previous error styling
        block.querySelectorAll('.select-display').forEach(display => {
          display.classList.remove('error');
        });
        
        // Check required fields
        if (!type || type === 'Film Type') {
          const typeDisplay = block.querySelector('[data-name="filmType"] .select-display');
          if (typeDisplay) typeDisplay.classList.add('error');
          errors.push(`Film block ${index + 1}: Please select a Film Type`);
        }
        
        if (!format || format === 'Film Format') {
          const formatDisplay = block.querySelector('[data-name="filmFormat"] .select-display');
          if (formatDisplay) formatDisplay.classList.add('error');
          errors.push(`Film block ${index + 1}: Please select a Film Format`);
        }
        
        if (!scanSize || scanSize === 'Scan size') {
          const scanSizeDisplay = block.querySelector('[data-name="filmscanSize"] .select-display');
          if (scanSizeDisplay) scanSizeDisplay.classList.add('error');
          errors.push(`Film block ${index + 1}: Please select a Scan Size`);
        }
      });
      
      return errors;
    }

