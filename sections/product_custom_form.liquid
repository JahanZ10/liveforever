    function initCustomSelect(container) {
      const display = container.querySelector('.select-display');
      const options = container.querySelector('.select-options');
      if (!options) return;
      
      const text = display?.querySelector('.selected-text');
      const price = display?.querySelector('.selected-price');
      const dataName = container.dataset.name;
      const isCustomRadio = container.closest('.custom-radio') !== null;

      // Only add click handler to display if it's visible
      if (display && display.style.display !== 'none') {
        display.onclick = (e) => {
          e.stopPropagation();
          const isOpen = options.style.display === 'block';
          document.querySelectorAll('.select-options').forEach((o) => {
            if (!o.closest('.custom-radio')) {
              o.style.display = 'none';
            }
          });
          document.querySelectorAll('.select-display').forEach((d) => d.classList.remove('open'));
          if (!isCustomRadio) {
            options.style.display = isOpen ? 'none' : 'block';
            display.classList.toggle('open', !isOpen);
          }
        };
      }

      options.querySelectorAll('li').forEach((li) => {
        li.onclick = (e) => {
          e.stopPropagation();
          options.querySelectorAll('li').forEach((i) => i.classList.remove('active'));
          li.classList.add('active');
          
          if (text) {
            text.textContent = li.textContent.trim();
          }
          
          // Remove error styling when a required field is selected
          if (dataName === 'filmFormat' || dataName === 'filmscanSize' || dataName === 'filmType') {
            if (display) display.classList.remove('error');
          }
          
          if (!isCustomRadio) {
            options.style.display = 'none';
            if (display) display.classList.remove('open');
          }
          
          // Update options visibility and sync hidden inputs
          const block = container.closest('.film-block');
