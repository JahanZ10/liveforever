      if (isMailToMeSelected) {
        itemIds.push({ id: '53057831698796', quantity: 1, contrast: '', brightness: '' });
      }
      
      let bodyInput = document.querySelector('textarea[name="contact[body]"]');
      if (!bodyInput) {
        bodyInput = document.createElement('textarea');
        bodyInput.name = 'contact[body]';
        bodyInput.style.display = 'none';
        document.getElementById('filmOrderForm').appendChild(bodyInput);
      }
      bodyInput.value = `Order Details:\n${orderDetails}\n\nTotal: $${window.allSelectedFilms.reduce((sum, item) => sum + (item.price * item.quantity), 0).toFixed(2)} USD`;
      
      let itemIdsInput = document.querySelector('input[name="contact[item_ids]"]');
      if (!itemIdsInput) {
        itemIdsInput = document.createElement('input');
        itemIdsInput.type = 'hidden';
        itemIdsInput.name = 'contact[item_ids]';
        document.getElementById('filmOrderForm').appendChild(itemIdsInput);
      }
      itemIdsInput.value = JSON.stringify(itemIds);
      
      // Submit the form
      document.getElementById('filmOrderForm').submit();
    }

    document.querySelector('.checkout-btn').addEventListener('click', function (e) {
      e.preventDefault();

      const agreeCheckbox = document.querySelector('.agree-checkbox');
      const errorMessageEl = document.querySelector('.form-error-message');

      // Validate required fields
      const validationErrors = validateRequiredFields();
      if (validationErrors.length > 0) {
        errorMessageEl.textContent = validationErrors[0] + (validationErrors.length > 1 ? ` (and ${validationErrors.length - 1} more error${validationErrors.length > 2 ? 's' : ''})` : '');
        errorMessageEl.style.display = 'block';
        const firstBlock = document.querySelector('.film-block');
        if (firstBlock) firstBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      if (!agreeCheckbox.checked) {
        errorMessageEl.textContent = 'Please agree to the terms of service before proceeding.';
        errorMessageEl.style.display = 'block';
        agreeCheckbox.closest('.terms').scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      } else {
        errorMessageEl.style.display = 'none';
      }

      if (window.allSelectedFilms.length === 0) {
        errorMessageEl.textContent = 'Please add at least one film roll before submitting.';
        errorMessageEl.style.display = 'block';
        return;
      }
      const name = document.querySelector('input[name="contact[name]"]')?.value.trim() || '';
      const email = document.querySelector('input[name="contact[email]"]')?.value.trim() || '';
      const firstFilm = window.allSelectedFilms[0];
      const filmType = firstFilm?.filmType || '';
      const format = firstFilm?.format || '';

      if (name === '' || email === '' || filmType === '' || format === '') {
        errorMessageEl.textContent = 'Please fill in your name, email, and select at least one film type and format before submitting.';
        errorMessageEl.style.display = 'block';
        return;
      }
      const totalQuantity = window.allSelectedFilms.reduce((sum, item) => sum + item.quantity, 0);
      const orderId = 'LF0{{ page.metafields.custom.form_id | plus: 1 }}';
      window.currentOrderId = orderId;
      document.getElementById('popupName').textContent = name || 'friend';
      document.getElementById('popupOrderId').textContent = orderId;
      document.getElementById('popupQuantity').textContent = totalQuantity;
      const filmDetailsEl = document.getElementById('popupFilmDetails');
      if (filmDetailsEl) {
        if (window.allSelectedFilms.length === 1) {
          const film = window.allSelectedFilms[0];
          filmDetailsEl.innerHTML = `
            <p style="margin:10px 0 0;"><strong>Film Type:</strong> ${film.filmType}</p>
            <p style="margin:0;"><strong>Format:</strong> ${film.format}</p>
          `;
        } else {
          // Multiple films - show all
          let filmsHtml = '<p style="margin:0 0 8px 0;"><strong>Films:</strong></p>';
          window.allSelectedFilms.forEach((film, index) => {
            filmsHtml += `
              <p style="margin:4px 0;font-size:14px;">
                ${film.quantity}× ${film.filmType} - ${film.format}${film.scanSize ? ' - ' + film.scanSize : ''}
              </p>
            `;
          });
          filmDetailsEl.innerHTML = filmsHtml;
        }
      }
      if (popup) popup.style.display = 'flex';
    });
    function collectFormData() {
      const totalQuantity = window.allSelectedFilms.reduce((sum, item) => sum + (parseInt(item.quantity) || 0), 0);
      let totalPrice = window.allSelectedFilms.reduce((sum, item) => {
        const price = parseFloat(item.price) || 0;
        const qty = parseInt(item.quantity) || 1;
        return sum + (price * qty);
      }, 0);
      const mailToMeRadio = document.querySelector('input[name="negatives"][value]');
      const checkedNegatives = document.querySelector('input[name="negatives"]:checked');
      const isMailToMeSelected = checkedNegatives && checkedNegatives.closest('label') &&
        checkedNegatives.closest('label').textContent.trim().toLowerCase().includes('mail to me');
      let mailToMePrice = 0;
      if (isMailToMeSelected && mailToMeRadio && mailToMeRadio.dataset.price) {
        const mailPriceStr = String(mailToMeRadio.dataset.price).replace(/[,\s$]/g, '');
        mailToMePrice = parseFloat(mailPriceStr) || 0;
        if (mailToMePrice > 0) {
          totalPrice += mailToMePrice;
        }
      }

      const rawOrderId =
        window.currentOrderId || document.getElementById('popupOrderId')?.textContent.trim() || '';
      const numericOrderId = parseInt((rawOrderId || '').replace(/[^0-9]/g, ''), 10) || '';
      console.log(numericOrderId)
      const formData = {
        order_id: numericOrderId,
        raw_id: rawOrderId,
        name: document.querySelector('input[name="contact[name]"]')?.value.trim() || '',
        email: document.querySelector('input[name="contact[email]"]')?.value.trim() || '',
        phone: document.querySelector('input[name="contact[phone]"]')?.value.trim() || '',
        instagram: document.querySelector('input[name="contact[instagram]"]')?.value.trim() || '',
        share_images: document.querySelector('input[name="contact[share_images]"]')?.checked ? 'Yes' : 'No',
        dropbox_location: window.globalLocation || '',
        negatives: window.globalNegatives || 'Keep (Collect in-store)',
        order_comments: window.globalNotes || '',
        films: window.allSelectedFilms.map((item, index) => ({
          film_number: index + 1,
          film_type: item.filmType || '',
          format: item.format || '',
          scan_size: item.scanSize || '',
          scanner: item.scanner || '',
          contrast: item.contrast || 'Standard',
          {% comment %} brightness: item.brightness || 'Standard', {% endcomment %}
          quantity: parseInt(item.quantity) || 1,
          variant_id: item.variantId || null,
          price: parseFloat(item.price) || 0,
          total_price: (parseFloat(item.price) || 0) * (parseInt(item.quantity) || 1)
        })),
        item_ids: (() => {
          const ids = window.allSelectedFilms.map((item) => ({
            id: item.variantId || null,
            quantity: parseInt(item.quantity) || 1,
            contrast: item.contrast || '',
             brightness: item.brightness || '' 
          })).filter((entry) => entry.id);
          if (isMailToMeSelected) {
            ids.push({ id: '53057831698796', quantity: 1, contrast: ''  , brightness: ''  });
          }
          return ids;
        })(),
        total_quantity: totalQuantity,
        total_price: parseFloat(totalPrice.toFixed(2)),
        mail_to_me_price: mailToMePrice > 0 ? parseFloat(mailToMePrice.toFixed(2)) : 0
      };

      return formData;
    }
    async function sendToWebhook(data) {
      const webhookUrl = 'https://hook.us2.make.com/6om7hmx8pg37oqo1frn9bbbm1lnjal7l';
      
      try {
        const jsonData = JSON.stringify(data, null, 2);
      
        console.log('Sending JSON to webhook:', jsonData);
        
        const response = await fetch(webhookUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: jsonData
        });

        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }
        let responseData;
        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
          responseData = await response.json();
        } else {
          responseData = await response.text();
        }

        return { success: true, response: responseData };
      } catch (error) {
        console.error('Error sending to webhook:', error);
        console.error('Data that failed to send:', JSON.stringify(data, null, 2));
        return { success: false, error: error.message };
      }
    }
    if (confirmBtn) {
      confirmBtn.addEventListener('click', async () => {
        const emailInput = document.querySelector('input[name="contact[email]"]');
        const email = emailInput?.value.trim() || '';
        if (!email) {
          const errorMessageEl = document.querySelector('.form-error-message');
          if (errorMessageEl) {
            errorMessageEl.textContent = 'Please enter your email address.';
            errorMessageEl.style.display = 'block';
          }
          const popupError = document.getElementById('popupError');
          if (popupError) {
            popupError.textContent = 'Please enter your email address.';
            popupError.style.display = 'block';
          }
          return;
        }

        if (!validateEmail(email)) {
          const errorMessageEl = document.querySelector('.form-error-message');
          if (errorMessageEl) {
            errorMessageEl.textContent = 'Please enter a valid email address.';
            errorMessageEl.style.display = 'block';
          }
          const popupError = document.getElementById('popupError');
          if (popupError) {
            popupError.textContent = 'Please enter a valid email address.';
            popupError.style.display = 'block';
          } else {
            const popupContent = document.querySelector('.popup-content');
            if (popupContent) {
              const errorDiv = document.createElement('div');
              errorDiv.id = 'popupError';
              errorDiv.style.cssText = 'color: #dc3545; margin: 10px 0; font-size: 14px; font-weight: 500;';
              errorDiv.textContent = 'Please enter a valid email address.';
              const buttons = popupContent.querySelector('.popup-buttons');
              if (buttons) {
                popupContent.insertBefore(errorDiv, buttons);
              }
            }
          }
          return;
        }
        const errorMessageEl = document.querySelector('.form-error-message');
        if (errorMessageEl) errorMessageEl.style.display = 'none';
        const popupError = document.getElementById('popupError');
        if (popupError) popupError.style.display = 'none';
        const formData = collectFormData();
        console.log('Form data collected:', formData);
        console.log('JSON payload:', JSON.stringify(formData, null, 2));
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Submitting...';
        const result = await sendToWebhook(formData);

        if (result.success) {
          const successMessage =
            'Thank you for your order. It has been successfully received. Once your rolls reach the lab, our team will send you a payment link and start developing!';
          const successEl = document.querySelector('.form-error-message');
          if (successEl) {
            successEl.textContent = successMessage;
            successEl.style.display = 'block';
            successEl.style.background = '#e9f8ef';
            successEl.style.border = '1px solid #b6e5c5';
            successEl.style.color = '#0f5132';
          }
          if (popup) popup.style.display = 'none';
          confirmBtn.textContent = 'Submitted';
          confirmBtn.disabled = true;
        } else {
          const errorMsg = 'Failed to send data to webhook. Please try again.';
          const errorMessageEl = document.querySelector('.form-error-message');
          if (errorMessageEl) {
            errorMessageEl.textContent = errorMsg;
            errorMessageEl.style.display = 'block';
          }
          const popupError = document.getElementById('popupError');
          if (popupError) {
            popupError.textContent = errorMsg;
            popupError.style.display = 'block';
          }
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Yes, Submit My Order!';
        }
      });
    }
    if (cancelBtn) {
      cancelBtn.addEventListener('click', () => {
        if (popup) popup.style.display = 'none';
      });
    }
    if (popup) {
      popup.addEventListener('click', (e) => {
        if (e.target === popup) popup.style.display = 'none';
      });
    }

    window.getOrder = () => ({
      items: window.allSelectedFilms,
      notes: window.globalNotes,
      location: window.globalLocation,
      negatives: window.globalNegatives,
    });
  });
</script>


