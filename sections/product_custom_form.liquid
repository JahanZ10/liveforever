<section class="film-order-section">
  <div class="container">
    {% comment %} <h2 class="section-title">Important: Please submit your order at the same time as
dropping off or mailing your rolls. This lets us know your film is
ready for collection or on its way.</h2> {% endcomment %}
<h2 class="section-title">Online Order Form</h2>
    {% comment %} <p class="section-desc">
      Choose your film type, scan size, and preferences — we'll handle the rest. Designed for professionals and
      hobbyists who want their film treated with care.
    </p> {% endcomment %}

    <form
      id="filmOrderForm"
      action="/contact#contact_form"
      method="post"
      accept-charset="UTF-8"
      class="film-order-form"
      novalidate
    >
      <input type="hidden" name="form_type" value="customer">
      <input type="hidden" name="utf8" value="✓">

      <div class="chose_steps_form_first">
        <div class="chose_steps_duplicate">
        {% comment %} <div class="form-title">Start Your Film Order</div>
        <p class="form-desc">Tell us about your film -- we'll develop, scan, and send it back with care.</p> {% endcomment %}

        <div class="form-group">
          <label for="instructions">Select Drop-off Box location (or select ‘Mail in’ for Mail in Orders)</label>
          <div class="custom-select" data-name="location">
            <div class="select-display">
              <span class="selected-text">Select Drop-off Box Location (or Mail In)</span>
              <span class="arrow">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 30.727 30.727"
                  fill="currentColor"
                >
                  <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                    c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                    c0.977-0.976,2.559-0.976,3.535,0
                    C30.971,7.624,30.971,9.206,29.994,10.183z"></path>
                </svg>
              </span>
            </div>
            <ul class="select-options">
              <li data-value="location_1">Live Forever Lab (Street Level)</li>
              <li data-value="location_2">Live Forever Lab Door (1st Floor)</li>
              <li data-value="location_3">The Soda Factory (Street Level)</li>
              <li data-value="location_5">Title Store Barangaroo (In-Store)</li>
              <li data-value="location_6">Mail In</li>
            </ul>
          </div>
        </div>

        <!-- Film Block Wrapper (for cloning) -->
        <div class="film-block">
          <button type="button" class="remove-film-btn" style="display: none;" aria-label="Remove film block">×</button>
          <input type="hidden" name="contact[Film Type]" class="sync-filmtype">
          <input type="hidden" name="contact[Film Format]" class="sync-filmformat">
          <input type="hidden" name="contact[Quantity]" class="sync-quantity" value="1">
          <input type="hidden" name="contact[Film Scan Size]" class="sync-filmscanSize">
          <input type="hidden" name="contact[Film Scanner]" class="sync-filmscanner" value="Noritsu">
          <input type="hidden" name="contact[Film Contrast]" class="sync-filmcontrast" value="Standard">
           <input type="hidden" name="contact[Film Brightness]" class="sync-filmbrightness" value="Standard"> 
          
          <div class="form-group film-type">
            <div class="film-type-wrapper">
              <div class="custom-select form-row" data-name="filmType">
                <div class="form-group">
                  <label>Select Your Film Type and Qty</label>
                  <div class="select-display">
                    <span class="selected-text">Film Type</span>
                    <span class="arrow">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 30.727 30.727"
                        fill="currentColor"
                      >
                        <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                          c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                          c0.977-0.976,2.559-0.976,3.535,0
                          C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                      </svg>
                    </span>
                  </div>
                  <ul class="select-options">
                    <li data-value="C41">C41</li>
                    <li data-value="B&W">B&W</li>
                    <li data-value="ECN-2">ECN-2</li>
                  </ul>
                </div>
                <div class="form-group">
                  <label style="opacity:0;">Select your Film Format</label>
                  <div class="custom-select" data-name="filmFormat">
                    <div class="select-display">
                      <span class="selected-text">Film Format</span>
                      <span class="arrow">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="14"
                          height="14"
                          viewBox="0 0 30.727 30.727"
                          fill="currentColor"
                        >
                          <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                            c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                            c0.977-0.976,2.559-0.976,3.535,0
                            C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                        </svg>
                      </span>
                    </div>
                    <ul class="select-options">
                      <li data-value="35mm">35mm</li>
                      <li data-value="120">120</li>
                    </ul>
                  </div>
                </div>
              </div>

              <div class="qty-controls">
                <label>Qty</label>
                <div class="qty-controls-input">
                  <input type="number" value="1" min="1" class="qty-input" readonly>
                  <div class="plus_minus_btn">
                    <button type="button" class="qty-btn plus">+</button>
                    <button type="button" class="qty-btn minus">-</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Select your scan size <span style="color: #dc3545;">*</span></label>
              <div class="custom-select" data-name="filmscanSize">
                <div class="select-display">
                  <span class="selected-text">Scan size</span>
                  <span class="arrow">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 30.727 30.727"
                      fill="currentColor"
                    >
                      <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                        c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                        c0.977-0.976,2.559-0.976,3.535,0
                        C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                    </svg>
                  </span>
                </div>
                <ul class="select-options">
                  <li data-value="Social">Social</li>
                  <li data-value="Classic">Classic (Large)</li>
                  <li data-value="Pro">Pro (Largest)</li>
                </ul>
              </div>
            </div>

            <div class="form-group">
              <label>Select your scanner</label>
              <div class="custom-select" data-name="filmscanner">
                <div class="select-display">
                  <span class="selected-text" data-value="Noritsu">Noritsu (default)</span>
                  <span class="arrow">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 30.727 30.727"
                      fill="currentColor"
                    >
                      <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                        c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                        c0.977-0.976,2.559-0.976,3.535,0
                        C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                    </svg>
                  </span>
                </div>
                <ul class="select-options">
                  <li class="active" data-value="Noritsu">Noritsu (default)</li>
                  <li data-value="Fujifilm Frontier">Fujifilm Frontier</li>
                   {% comment %} <li data-value="Fujifilm Frontier">Kodak Pakon</li> {% endcomment %}
                
                </ul>
              </div>
            </div>
          </div>

          <!-- SCAN PREFERENCES -->
          <div class="form-title" style="margin-top: 24px; font-size: 16px;">
            Tell us your scan preferences for the film type (Standard and Pro size scan only)
          </div>
          <div class="form-row custom-radio">
            <div class="form-group">
              <label>Select your Contrast</label>
              <div class="custom-select" data-name="filmcontrast">
                <div class="select-display" style="display:none;">
                  <span class="selected-text">Standard</span>
                  <span class="arrow">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 30.727 30.727"
                      fill="currentColor"
                    >
                      <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                        c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                        c0.977-0.976,2.559-0.976,3.535,0
                        C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                    </svg>
                  </span>
                </div>
                <ul class="select-options">
                  <li data-value="Standard" class="active">Standard</li>
                  {% comment %} <li data-value="High">High</li> {% endcomment %}
                  <li data-value="Low (Flat)">Low (Flat)</li>
                </ul>
              </div>
            </div>

            {% comment %} <div class="form-group">
              <label>Select Brightness</label>
              <div class="custom-select" data-name="filmbrightness">
                <div class="select-display" style="display:none;">
                  <span class="selected-text">Standard</span>
                  <span class="arrow">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 30.727 30.727"
                      fill="currentColor"
                    >
                      <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                        c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                        c0.977-0.976,2.559-0.976,3.535,0
                        C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                    </svg>
                  </span>
                </div>
                <ul class="select-options">
                  <li data-value="Standard" class="active">Standard</li>
                  <li data-value="Bright">Bright</li>
                  <li data-value="Dark">Dark</li>
                </ul>
              </div>
            </div> {% endcomment %}
          </div>
        </div>
        <!-- End Film Block -->
        </div>

        <button type="button" class="add-film-btn">Add another film type +</button>
      </div>

      <!-- Second & Third Sections (unchanged) -->
      <div class="chose_steps_form_second">
          <div class="form-title" style="margin-top:30px;">Your Contact Details</div>
         <div class="form-row">
          <div class="form-group">
            <label>Name <span style="color:red;">*</span></label>
            <input type="text" name="contact[name]" placeholder="John Doe" required class="select-display">
          </div>
          <div class="form-group half">
            <label>Email <span style="color:red;">*</span></label>
            <input type="email" name="contact[email]" placeholder="john@example.com" required class="select-display" id="emailInput">
            <div id="emailError" style="display: none; color: #dc3545; font-size: 12px; margin-top: 4px;"></div>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group half">
            <label>Phone</label>
            <input type="tel" name="contact[phone]" placeholder="+61 4123 123 123" class="select-display">
          </div>
          <div class="form-group">
            <label>Instagram (optional)</label>
            <input type="text" name="contact[instagram]" placeholder="@yourhandle" class="select-display">
          </div>
        </div>

        <div class="form-group" style="margin:30px 0;">
          <label style="display:flex;align-items:flex-start;gap:14px;cursor:pointer;font-size:16px;">
            <input type="checkbox" name="contact[share_images]" value="Yes – you may share my images">
            <span>Yes, it's okay to share my images on your Instagram & website (we'll always tag you!)</span>
          </label>
        </div>
        <div class="turnaround">
          <div class="heading_like">What would you like us to do with your negatives?</div>
          <div class="negatives-options">
            <label class="option active">
              <input type="radio" name="negatives" checked>
              <span>Keep (Collect in-store)</span>
            </label>
            <label class="option">
              {% assign mail = all_products['mail-to-me'] %}
              <input type="radio" name="negatives" value="{{ mail.selected_or_first_available_variant.id }}" data-price="{{ mail.selected_or_first_available_variant.price | money }}">
              <span>Mail to me</span>
            </label>
            <label class="option">
              <input type="radio" name="negatives">
              <span>Dispose</span>
            </label>
          </div>
          {%comment %}
          <p class="note">You can collect your negatives at our lab</p>
          <div class="address">
            <div>Address:</div>
            <div>
              <span>Australia – Filmforever HQ, 501 Crown St, Surry Hills NSW 2010, Australia</span><br>
              <a href="#" target="_blank">View on Google Maps</a>
            </div>
          </div>
          {%endcomment %}
          <div class="form-group">
            <label for="instructions">Order Comments</label>
            <textarea
              id="instructions"
              rows="3"
              placeholder="Let us know any special notes about your order"
            ></textarea>
          </div>
        </div>
      </div>

      <div class="chose_steps_form_third">
        <div class="order-summary">
          <div class="order_heading">Order Summary</div>
          <p class="order-summary-text">No items selected</p>
          <div class="order-items-container"></div>
          <p class="notes" style="display: none;"></p>
          <div class="order-total">
            <span>Total:</span>
            <span class="total-price">$0</span>
          </div>
        </div>

        <div class="terms">
          <div class="terms_service">Terms of service</div>
          <p>
           By submitting this order, I agree to Live Forever Film Lab’s terms of service.
          </p>
          <p>
            If you need to amend an already submitted form, email us at
            <a href="mailto:support@filmforever.com" class="support_text">support@Filmforever.com</a>
          </p>

          <label class="agree-label">
            <input type="checkbox" required class="agree-checkbox">
            <span>I Agree</span>
          </label>
        </div>

        <div class="form-error-message" style="display: none; color: red; margin-top: 10px; font-size: 14px;"></div>

        <button type="submit" class="checkout-btn">
           Submit your order <span class="checkout-total">$0</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Order Confirm Popup -->
  <div id="orderConfirmPopup" class="popup-overlay" style="display:none;">
    <div class="popup-content">
      {% comment %} <div style="margin:0px;">Film roll</div> {% endcomment %}
      <h3>Almost there!</h3>

      <p style="font-size:17px;line-height:1.6;color:#333; display:none;">
        Hey <strong><span id="popupName">friend</span></strong
        >, Welcome to the family! This is your first order with us — we're so excited to develop your rolls!
      </p>

      <div
        class="order-summary"
        style="background:#fff9f0;border:2px dashed #ff9d43;padding:10px;border-radius:12px;margin:10px 0;"
      >
        <p style="margin:10px 0 0;">
          <strong>Order ID:</strong>
          <span id="popupOrderId" style="font-size:22px;color:#d35400;font-weight:800;">ABC001</span>
        </p>
        <div id="popupFilmDetails" style="margin:10px 0 0;">
          <!-- Film details will be populated here -->
        </div>
        <p style="margin:0;"><strong>Total Rolls:</strong> <span id="popupQuantity">1</span> roll(s)</p>
      </div>

      <p style="color:#555;font-size:15px;margin-bottom:25px;">
        Once your rolls are received, we’ll send you a payment link and start developing!
      </p>

      <div id="popupError" style="display: none; color: #dc3545; margin: 10px 0; font-size: 14px; font-weight: 500; padding: 10px; background: #fee; border: 1px solid #fcc; border-radius: 4px;"></div>

      <div class="popup-buttons">
        <button type="button" id="cancelPopup">Wait, let me check again</button>
        <button type="button" id="confirmSubmit">Yes, Submit My Order!</button>
      </div>
    </div>
  </div>
</section>
{% assign raw_handles = 'b-w,
   ecn-2,
   c41'
  | split: ','
%}
<script type="application/json" id="film-varaints-data">
  [
  {%- for h in raw_handles -%}
    {%- assign clean_handle = h | strip -%}
    {%- assign p = all_products[clean_handle] -%}
    {%- if p -%}
      {
        "handle": "{{ p.handle }}",
        "title": "{{ p.title | escape }}",
        "item_ids": [{% for v in p.variants %}"{{ v.id }}"{% unless forloop.last %}, {% endunless %}{% endfor %}],
        "variants": [
          {%- for v in p.variants -%}
          { "id": "{{ v.id }}", "title": "{{ v.title | escape }}", "option1": "{{ v.option1 | escape }}", "option2": "{{ v.option2 | escape }}", "option3": "{{ v.option3 | escape }}", "price": {{ v.price }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }{% unless forloop.last %},{% endunless %}
    {%- endif -%}
  {% endfor %}
  ]
</script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Load variant data (includes price per variant from Shopify)
    const filmVariantsScript = document.getElementById('film-varaints-data');
    const filmVariantsData = filmVariantsScript ? JSON.parse(filmVariantsScript.textContent) : [];

    window.allSelectedFilms = [];
    window.globalNotes = '';
    window.globalLocation = '';
    window.globalNegatives = 'Keep (Collect in-store)';

    // Normalize scanner option3 to dropdown value (Noritsu / Fujifilm Frontier)
    function normalizeScannerOption(option3) {
      if (!option3) return '';
      const s = String(option3).trim();
      if (s.indexOf('Noritsu') !== -1) return 'Noritsu';
      if (s.indexOf('Fujifilm') !== -1) return 'Fujifilm Frontier';
      return s;
    }

    // Get variants for a film type and format from filmVariantsData
    function getVariantsForFormat(filmType, format) {
      const typeNorm = normalizeFilmTypeTitle(filmType || '');
      const film = filmVariantsData.find((f) => normalizeFilmTypeTitle(f.title) === typeNorm);
      if (!film || !Array.isArray(film.variants)) return [];
      const formatTrim = (format || '').trim();
      return film.variants.filter((v) => (v.option1 || '').trim() === formatTrim);
    }

    // Populate scan size and scanner dropdowns from variants (options driven by film-variants-data)
    function updateOptionsVisibility(block) {
      const typeEl = block.querySelector('[data-name="filmType"] .selected-text');
      const formatEl = block.querySelector('[data-name="filmFormat"] .selected-text');
      const scanSizeSelect = block.querySelector('[data-name="filmscanSize"]');
      const scannerSelect = block.querySelector('[data-name="filmscanner"]');
      
      const filmType = typeEl?.textContent.trim();
      const format = formatEl?.textContent.trim();
      
      if (!filmType || filmType === 'Film Type') {
        return;
      }

      const variants = getVariantsForFormat(filmType, format);
      if (variants.length === 0) {
        // No format selected or no variants: leave dropdowns as-is (static or placeholder)
        return;
      }

      // Unique option2 (scan size) and option3 (scanner) from variants
      const scanSizeSet = new Map();
      const scannerSet = new Map();
      variants.forEach((v) => {
        const o2 = (v.option2 || '').trim();
        const o3 = (v.option3 || '').trim();
        const sizeKey = o2.split('(')[0].trim();
        if (o2 && !scanSizeSet.has(sizeKey)) scanSizeSet.set(sizeKey, o2);
        const scannerKey = normalizeScannerOption(o3);
        if (scannerKey && !scannerSet.has(scannerKey)) scannerSet.set(scannerKey, o3);
      });

      const scanSizeOptions = Array.from(scanSizeSet.entries()).sort((a, b) => a[1].localeCompare(b[1]));
      const scannerOptions = Array.from(scannerSet.entries());

      // Rebuild scan size dropdown
      if (scanSizeSelect) {
        const ul = scanSizeSelect.querySelector('.select-options');
        const displayText = scanSizeSelect.querySelector('.selected-text');
        const currentDisplay = displayText?.textContent.trim();
        const currentSizeKey = currentDisplay ? currentDisplay.split('(')[0].trim() : '';
        const currentInList = scanSizeOptions.some(([k]) => k === currentSizeKey);
        const firstSize = scanSizeOptions[0];
        const selectedSize = currentInList ? currentSizeKey : (firstSize ? firstSize[0] : null);
        const selectedDisplay = selectedSize ? (scanSizeSet.get(selectedSize) || selectedSize) : 'Scan size';

        ul.innerHTML = '';
        scanSizeOptions.forEach(([dataVal, displayVal]) => {
          const li = document.createElement('li');
          li.dataset.value = dataVal;
          li.textContent = displayVal;
          if (dataVal === selectedSize) li.classList.add('active');
          ul.appendChild(li);
        });
        if (displayText) displayText.textContent = selectedDisplay;
        const hiddenInput = block.querySelector('.sync-filmscanSize');
        if (hiddenInput) hiddenInput.value = selectedSize || '';

        // Re-attach click handler for new list items
        const container = scanSizeSelect;
        const options = ul;
        const text = displayText;
        const dataName = container.dataset.name;
        options.querySelectorAll('li').forEach((li) => {
          li.onclick = (e) => {
            e.stopPropagation();
            options.querySelectorAll('li').forEach((i) => i.classList.remove('active'));
            li.classList.add('active');
            if (text) text.textContent = li.textContent.trim();
            document.querySelectorAll('.select-options').forEach((o) => { if (o !== options) o.style.display = 'none'; });
            container.querySelector('.select-display')?.classList.remove('open');
            options.style.display = 'none';
            if (dataName === 'filmscanSize') container.classList.remove('error');
            const blk = container.closest('.film-block');
            if (blk) { updateOptionsVisibility(blk); syncHiddenInputs(blk); }
            setTimeout(updateAllFilms, 50);
          };
        });
      }

      // Rebuild scanner dropdown
      if (scannerSelect) {
        const ul = scannerSelect.querySelector('.select-options');
        const displayText = scannerSelect.querySelector('.selected-text');
        const currentDisplay = displayText?.textContent.trim();
        const currentScannerKey = currentDisplay ? normalizeScannerOption(currentDisplay) : 'Noritsu';
        const currentInList = scannerOptions.some(([k]) => k === currentScannerKey);
        const firstScanner = scannerOptions[0];
        const selectedKey = currentInList ? currentScannerKey : (firstScanner ? firstScanner[0] : 'Noritsu');
        const selectedDisplay = selectedKey ? (scannerSet.get(selectedKey) || selectedKey) : 'Noritsu (default)';

        ul.innerHTML = '';
        scannerOptions.forEach(([dataVal, displayVal]) => {
          const li = document.createElement('li');
          li.dataset.value = dataVal;
          li.textContent = displayVal;
          if (dataVal === selectedKey) li.classList.add('active');
          ul.appendChild(li);
        });
        if (displayText) displayText.textContent = selectedDisplay;
        const hiddenInput = block.querySelector('.sync-filmscanner');
        if (hiddenInput) hiddenInput.value = selectedKey || 'Noritsu';

        const scannerOptionsEl = scannerSelect.querySelector('.select-options');
        const scannerContainer = scannerSelect;
        const scannerText = displayText;
        scannerOptionsEl.querySelectorAll('li').forEach((li) => {
          li.onclick = (e) => {
            e.stopPropagation();
            scannerOptionsEl.querySelectorAll('li').forEach((i) => i.classList.remove('active'));
            li.classList.add('active');
            if (scannerText) scannerText.textContent = li.textContent.trim();
            document.querySelectorAll('.select-options').forEach((o) => { if (o !== scannerOptionsEl) o.style.display = 'none'; });
            scannerContainer.querySelector('.select-display')?.classList.remove('open');
            scannerOptionsEl.style.display = 'none';
            const blk = scannerContainer.closest('.film-block');
            if (blk) { syncHiddenInputs(blk); }
            setTimeout(updateAllFilms, 50);
          };
        });
      }
    }

    // Normalize film type for matching (JSON may have &amp; etc.)
    function normalizeFilmTypeTitle(t) {
      if (!t) return '';
      const div = document.createElement('div');
      div.innerHTML = t.trim();
      return div.textContent.trim();
    }
    // Resolve variant from film variants data by current selection (returns full variant object with id, title, price or null)
    function findVariant(filmType, format, scanSize, scanner) {
      const typeNorm = normalizeFilmTypeTitle(filmType || '');
      const film = filmVariantsData.find((f) => normalizeFilmTypeTitle(f.title) === typeNorm);
      if (!film || !Array.isArray(film.variants)) return null;
      const option2Size = (s) => (s || '').split('(')[0].trim();
      const variant = film.variants.find((v) => {
        const opt1 = (v.option1 || '').trim();
        const opt2 = option2Size(v.option2);
        const opt3 = (v.option3 || '').trim();
        const matchFormat = opt1 === (format || '').trim();
        const matchSize = opt2 === (scanSize || '').trim();
        const matchScanner = (scanner && (opt3.indexOf(scanner) === 0 || opt3.includes(scanner))) || (!scanner && opt3.toLowerCase().includes('noritsu'));
        return matchFormat && matchSize && matchScanner;
      });
      return variant || null;
    }
    function findVariantId(filmType, format, scanSize, scanner) {
      const v = findVariant(filmType, format, scanSize, scanner);
      return v ? v.id : null;
    }

    function getBlockData(block) {
      const typeEl = block.querySelector('[data-name="filmType"] .selected-text');
      const formatEl = block.querySelector('[data-name="filmFormat"] .selected-text');
      const scanSizeEl = block.querySelector('[data-name="filmscanSize"] .selected-text');
      const scannerEl = block.querySelector('[data-name="filmscanner"] .selected-text');
      const contrastEl = block.querySelector('[data-name="filmcontrast"] .selected-text');
      const brightnessEl = block.querySelector('[data-name="filmbrightness"] .selected-text');
      const qty = parseInt(block.querySelector('.qty-input')?.value) || 1;

      const type = typeEl?.textContent.trim();
      const format = formatEl?.textContent.trim();
      let scanSize = scanSizeEl?.textContent.trim();
      // Extract just the size name (remove parenthetical)
      if (scanSize) {
        scanSize = scanSize.split('(')[0].trim();
      }
      
      let scanner = scannerEl?.textContent.trim() || 'Noritsu (default)';
      // Normalize scanner name
      if (scanner.includes('Noritsu')) scanner = 'Noritsu';
      else if (scanner.includes('Fujifilm')) scanner = 'Fujifilm Frontier';
      
      const contrast = contrastEl?.textContent.trim() || 'Standard';
      const brightness = brightnessEl?.textContent.trim() || 'Standard';

      // Validation: Check if required fields are selected
      if (!type || type === 'Film Type') return null;
      if (!format || format === 'Film Format') return null;
      if (!scanSize || scanSize === 'Scan size') return null;

      // Resolve variant from film-variants-data; price comes from variant (Shopify stores price in cents)
      const variantMatch = findVariant(type, format, scanSize, scanner);
      if (!variantMatch) return null;
      const price = (variantMatch.price != null) ? Number(variantMatch.price) / 100 : 0;
      if (price <= 0) return null;

      const variantId = String(variantMatch.id);
      const variantTitle = (variantMatch.title || '').trim() || (function () {
        const parts = [];
        if (format) parts.push(format);
        if (scanSize && scanSize !== 'Scan size') parts.push(scanSize);
        if (scanner && scanner !== 'Noritsu') parts.push(scanner);
        return parts.length > 0 ? parts.join(' / ') : type;
      })();

      // Build display text
      const displayText = `${qty} × ${type}`;

      return {
        quantity: qty,
        price: price,
        variantId: variantId,
        variantTitle: variantTitle,
        display: displayText,
        {% comment %} brightness: brightness, {% endcomment %}
        format: format,
        scanSize: scanSize,
        scanner: scanner,
        contrast: contrast,
        filmType: type,
      };
    }

    function updateAllFilms() {
      window.allSelectedFilms = [];

      document.querySelectorAll('.film-block').forEach((block) => {
        const data = getBlockData(block);
        if (data) window.allSelectedFilms.push(data);
      });

      window.globalNotes = document.getElementById('instructions')?.value.trim() || '';
      const locEl = document.querySelector('[data-name="location"] .selected-text');
      window.globalLocation = locEl?.textContent.trim() || '';

      const checkedNeg = document.querySelector('input[name="negatives"]:checked');
      window.globalNegatives = checkedNeg
        ? checkedNeg.nextElementSibling.textContent.trim()
        : 'Keep (Collect in-store)';

      const container = document.querySelector('.order-items-container');
      const summaryText = document.querySelector('.order-summary-text');
      const totalEl = document.querySelector('.total-price');
      const checkoutBtnTotal = document.querySelector('.checkout-total');
      const notesEl = document.querySelector('.order-summary .notes');

      if (window.allSelectedFilms.length === 0) {
        summaryText.textContent = 'No items selected';
        container.innerHTML = '';
        totalEl.textContent = '$0.00';
        checkoutBtnTotal.textContent = '$0';
        notesEl.style.display = 'none';
        return;
      }

      // Check if "Mail to me" is selected
      const mailToMeRadio = document.querySelector('input[name="negatives"][value]');
      const isMailToMeSelected = mailToMeRadio && mailToMeRadio.checked;
      
      // Count total items including mail product if selected
      let totalItemCount = window.allSelectedFilms.length;
      if (isMailToMeSelected) {
        totalItemCount += 1;
      }
      
      summaryText.textContent = `${totalItemCount} item${
        totalItemCount > 1 ? 's' : ''
      } selected`;
      container.innerHTML = '';
      let grandTotal = 0;

      window.allSelectedFilms.forEach((item) => {
        // Ensure price is a valid number
        const itemPrice = parseFloat(item.price) || 0;
        const itemQty = parseInt(item.quantity) || 1;
        const lineTotal = itemPrice * itemQty;
        grandTotal += lineTotal;

        // Format price with 2 decimal places
        const formattedPrice = lineTotal.toFixed(2);
        const formattedUnitPrice = itemPrice.toFixed(2);

        const div = document.createElement('div');
        div.style.cssText = 'padding: 12px 0; border-bottom: 1px solid #eee; font-size: 14px;';
        div.innerHTML = `
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-weight: 600;">
            <span>${item.display}</span>
            <span>$${formattedPrice}</span>
          </div>
          <div style="color: #666; font-size: 13px; margin-left: 4px;">
            <strong>Selected Options</strong>: ${item.variantTitle} / ${item.brightness}
            ${itemQty > 1 ? `<br><span style="color: #999;">Unit Price: $${formattedUnitPrice} × ${itemQty}</span>` : ''}
          </div>
        `;
        container.appendChild(div);
      });

      // Add "Mail to me" product to order summary if selected
      if (isMailToMeSelected && mailToMeRadio.dataset.price) {
        const mailPriceStr = String(mailToMeRadio.dataset.price).replace(/[,\s$]/g, '');
        const mailPrice = parseFloat(mailPriceStr);
        if (!isNaN(mailPrice) && mailPrice > 0) {
          grandTotal += mailPrice;
          const mailDiv = document.createElement('div');
          mailDiv.style.cssText = 'padding: 12px 0; border-bottom: 1px solid #eee; font-size: 14px;';
          mailDiv.innerHTML = `
            <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-weight: 600;">
              <span>Mail to me</span>
              <span>$${mailPrice.toFixed(2)} USD</span>
            </div>
          `;
          container.appendChild(mailDiv);
        }
      }

      let notesHtml = '';
      if (window.globalNotes) notesHtml += `<strong>Order Comments:</strong> ${window.globalNotes}<br>`;
      if (window.globalLocation && !window.globalLocation.includes('Select Drop')) {
        notesHtml += `<strong>Drop-box Location:</strong> ${window.globalLocation}<br>`;
      }
      notesHtml += `<strong>Negatives:</strong> ${window.globalNegatives}`;

      notesEl.innerHTML = notesHtml;
      notesEl.style.display = 'block';

      // Format total price with 2 decimal places
      const totalFormatted = `$${grandTotal.toFixed(2)}`;
      if (totalEl) totalEl.textContent = totalFormatted;
      if (checkoutBtnTotal) checkoutBtnTotal.textContent = totalFormatted;
    }

