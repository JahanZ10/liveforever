<section class="film-order-section">
    <div class="container">
      <h2 class="section-title">Start Your Film Order</h2>
      <p class="section-desc">Choose your film type, format and how many rolls — we’ll take care of the rest.</p>
  
      <form
        id="filmOrderForm"
        action="/contact#contact_form"
        method="post"
        accept-charset="UTF-8"
        class="film-order-form"
        novalidate
      >
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
  
        <input type="hidden" name="contact[Film Type]" class="sync-filmtype">
        <input type="hidden" name="contact[Film Format]" class="sync-filmformat">
        <input type="hidden" name="contact[Quantity]" class="sync-quantity" value="1">
        <input type="hidden" name="contact[Drop Box Location]" class="sync-location">
        <input type="hidden" name="contact[Film Scan Size]" class="sync-filmscanSize">
        <input type="hidden" name="contact[Film Scanner]" class="sync-filmscanner" value="Noritsu">
        <input type="hidden" name="contact[Film Contrast]" class="sync-filmcontrast" value="Standard">
        <input type="hidden" name="contact[Film Brightness]" class="sync-filmbrightness" value="Standard">
        <input type="hidden" name="contact[Order ID]" id="orderIdField">
        <input type="hidden" name="contact[Negatives Mail Fee]" id="negativesMailFee" value=""
>
        <div class="chose_steps_form_first">
          <div class="chose_steps_duplicate">
          <div class="form-title">Start Your Film Order</div>
  
          <div class="form-group">
            <div class="custom-select" data-name="location">
              <div class="select-display">
                <span class="selected-text">Select Drop Box Location</span>
                <span class="arrow">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 30.727 30.727"
                    fill="currentColor"
                  >
                    <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536 c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647 c0.977-0.976,2.559-0.976,3.535,0 C30.971,7.624,30.971,9.206,29.994,10.183z"></path>
                  </svg>
                </span>
              </div>
              <ul class="select-options">
                <li data-value="location_1">Live Forever Lab (Street Level)</li>
                <li data-value="location_2">Live Forever Lab Door (1st Floor)</li>
                <li data-value="location_3">The Soda Factory (Street Level)</li>
                <li data-value="location_5">Title Store Barangaroo (In-Store)</li>
                <li data-value="location_6">Mail In</li>
              </ul>
            </div>
          </div>
  
          <div class="form-group film-type">
            <div class="film-type-wrapper">
              <div class="conatct_custom-select form-row">
                <div class="custom-select form-group" data-name="filmtype">
                  <label>Select Your Film Type and Qty</label>
                  <div class="select-display">
                    <span class="selected-text">Film Type</span>
                    <span class="arrow">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 30.727 30.727"
                        fill="currentColor"
                      >
                        <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536 c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647 c0.977-0.976,2.559-0.976,3.535,0 C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                      </svg>
                    </span>
                  </div>
                  <ul class="select-options">
                    <li data-value="C41">C41</li>
                    <li data-value="B&W">B&W</li>
                    <li data-value="ECN-2">ECN-2</li>
                  </ul>
                </div>
                <div class="form-group">
                  <label style="opacity:0;">Select your Film Format</label>
                  <div class="custom-select" data-name="filmformat">
                    <div class="select-display">
                      <span class="selected-text">Film Format</span>
                      <span class="arrow">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="14"
                          height="14"
                          viewBox="0 0 30.727 30.727"
                          fill="currentColor"
                        >
                          <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536 c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647 c0.977-0.976,2.559-0.976,3.535,0 C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                        </svg>
                      </span>
                    </div>
                    <ul class="select-options">
                      <li data-value="35mm">35mm</li>
                      <li data-value="120">120</li>
                    </ul>
                  </div>
                </div>
              </div>
  
              <div class="qty-controls">
                <input type="number" value="1" min="1" class="qty-input" readonly>
                <div class="plus_minus_btn">
                  <button type="button" class="qty-btn plus">+</button>
                  <button type="button" class="qty-btn minus">−</button>
                </div>
              </div>
            </div>
          </div>
  
          <div class="form-row">
            <div class="form-group">
              <label>Select your scan size <span style="color: #dc3545;">*</span></label>
              <div class="custom-select" data-name="filmscanSize">
                <div class="select-display">
                  <span class="selected-text">Scan size</span>
                  <span class="arrow">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 30.727 30.727"
                      fill="currentColor"
                    >
                      <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                        c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                        c0.977-0.976,2.559-0.976,3.535,0
                        C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                    </svg>
                  </span>
                </div>
                <ul class="select-options">
                  <li data-value="Social">Social</li>
                  <li data-value="Classic">Classic</li>
                  <li data-value="Pro">Pro</li>
                </ul>
              </div>
            </div>

            <div class="form-group">
              <label>Select your scanner</label>
              <div class="custom-select" data-name="filmscanner">
                <div class="select-display">
                  <span class="selected-text" data-value="Noritsu">Noritsu (default)</span>
                  <span class="arrow">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 30.727 30.727"
                      fill="currentColor"
                    >
                      <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                        c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                        c0.977-0.976,2.559-0.976,3.535,0
                        C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                    </svg>
                  </span>
                </div>
                <ul class="select-options">
                  <li class="active" data-value="Noritsu">Noritsu (default)</li>
                  <li data-value="Fujifilm Frontier">Fujifilm Frontier</li>
                  <li data-value="Imacon Flextight">Imacon Flextight</li>
                </ul>
              </div>
            </div>
          </div>
          </div>
  
          <button type="button" class="add-film-btn">Add another film type +</button>

                    <div class="form-title" style="margin-top: 24px; font-size: 16px;">
            Tell us your scan preferences for the film type (Classic and Pro size scan only)
          </div>
  
          <div class="form-row custom-radio">
            <div class="form-group">
              <label>Select your Contrast</label>
              <div class="custom-select" data-name="filmcontrast">
                <div class="select-display" style="display:none;">
                  <span class="selected-text">Standard</span>
                  <span class="arrow">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 30.727 30.727"
                      fill="currentColor"
                    >
                      <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536 c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647 c0.977-0.976,2.559-0.976,3.535,0 C30.971,7.624,30.971,9.206,29.994,10.183z"></path>
                    </svg>
                  </span>
                </div>
                <ul class="select-options">
                  <li data-value="Standard" class="active">Standard</li>
                  <li data-value="High">High</li>
                  <li data-value="Low (Flat)">Low (Flat)</li>
                </ul>
              </div>
            </div>
  
            <div class="form-group">
              <label>Select Brightness</label>
              <div class="custom-select" data-name="filmbrightness">
                <div class="select-display" style="display:none;">
                  <span class="selected-text">Standard</span>
                  <span class="arrow">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 30.727 30.727"
                      fill="currentColor"
                    >
                      <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536 c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647 c0.977-0.976,2.559-0.976,3.535,0 C30.971,7.624,30.971,9.206,29.994,10.183z"></path>
                    </svg>
                  </span>
                </div>
                <ul class="select-options">
                  <li data-value="Standard" class="active">Standard</li>
                  <li data-value="Bright">Bright</li>
                  <li data-value="Dark">Dark</li>
                </ul>
              </div>
            </div>
          </div>
  
          <div class="form-title" style="margin-top:30px;">Your Contact Details</div>
  
          <div class="form-row">
            <div class="form-group">
              <label>Name <span style="color:red;">*</span></label>
              <input type="text" name="contact[name]" placeholder="John Doe" required class="select-display">
            </div>
            <div class="form-group half">
              <label>Email <span style="color:red;">*</span></label>
              <input type="email" name="contact[email]" placeholder="john@example.com" required class="select-display">
            </div>
          </div>
  
          <div class="form-row">
            <div class="form-group half">
              <label>Phone</label>
              <input type="tel" name="contact[phone]" placeholder="+1 (555) 123-4567" class="select-display">
            </div>
            <div class="form-group">
              <label>Instagram (optional)</label>
              <input type="text" name="contact[instagram]" placeholder="@yourhandle" class="select-display">
            </div>
          </div>
  
          <div class="form-group" style="margin:30px 0;">
            <label style="display:flex;align-items:flex-start;gap:14px;cursor:pointer;font-size:16px;">
              <input type="checkbox" name="contact[share_images]" value="Yes – you may share my images">
              <span>Yes, it’s okay to share my images on your Instagram & website (we’ll always tag you!)</span>
            </label>
          </div>

          <div class="form-group">
           <div class="heading_like">What would you like us to do with your negatives?</div>

<div class="negatives-options">
            <label class="option active">
              <input type="radio" name="negatives" checked="">
              <span>Keep (Collect in-store)</span>
            </label>
            <label class="option">
              
              <input type="radio" name="negatives" value="Mail to me" data-price="$12.50">
              <span>Mail to me</span>
            </label>
            <label class="option">
              <input type="radio" name="negatives">
              <span>Dispose</span>
            </label>
          </div>
          </div>
  
          <div class="form-group">
            <label>Order Comments</label>
            <textarea name="contact[body]" rows="4" placeholder="Any special requests?"></textarea>
          </div>
  
          <button
            type="button"
            id="openPopupBtn"
            style="width:100%;padding:18px;font-size:18px;background:#000;color:#fff;border:none;cursor:pointer;margin-top:20px;border-radius:12px;"
          >
            Submit Order
          </button>
        </div>
      </form>
    </div>
  </section>
  
  <input type="hidden" name="form_id" id="lf_form_id" value="">
  <p id="lf_form_id_preview" style="margin-top:8px;"></p>
  
  <div id="orderConfirmPopup" class="popup-overlay" style="display:none;">
    <div class="popup-content">
      <div style="margin:0px;">Film roll</div>
      <h3>Almost there!</h3>
  
      <p style="font-size:17px;line-height:1.6;color:#333;">
        Hey <strong><span id="popupName">friend</span></strong
        >, Welcome to the family! This is your first order with us — we’re so excited to develop your rolls!
      </p>
  
      <div
        class="order-summary"
        style="background:#fff9f0;border:2px dashed #ff9d43;padding:10px;border-radius:12px;margin:10px 0;"
      >
        <p style="margin:10px 0 0;">
          <strong>Order ID:</strong>
          <span id="popupOrderId" style="font-size:22px;color:#d35400;font-weight:800;">ABC001</span>
        </p>
        <p style="margin:10px 0 0;"><strong>Film Type:</strong> <span id="popupFilmType">—</span></p>
        <p style="margin:10px 0 0;"><strong>Format:</strong> <span id="popupFormat">—</span></p>
        <p style="margin:0;"><strong>Rolls:</strong> <span id="popupQuantity">1</span> roll(s)</p>
      </div>
  
      <p style="color:#555;font-size:15px;margin-bottom:25px;">
        We’ll email you confirmation + drop-off details soon. Can’t wait to see your shots!
      </p>
  
      <div class="popup-buttons">
        <button type="button" id="cancelPopup">Wait, let me check again</button>
        <button type="button" id="confirmSubmit">Yes, Submit My Order!</button>
      </div>
    </div>
  </div>
  
  <script>
    document.querySelectorAll('.custom-select').forEach((select) => {
      const display = select.querySelector('.selected-text');
      const list = select.querySelector('.select-options');
      const items = select.querySelectorAll('li');
      const hiddenInput = document.querySelector('.sync-' + select.dataset.name);

      if (!list || !items.length) return;

      const trigger = select.querySelector('.select-display');
      if (trigger) {
        trigger.addEventListener('click', () => {
          list.style.display = list.style.display === 'block' ? 'none' : 'block';
        });
      }

      items.forEach((item) => {
        item.addEventListener('click', () => {
          items.forEach(i => i.classList.remove('active'));
          item.classList.add('active');

          const value = item.textContent.trim();
          if (display) display.textContent = value;
          if (hiddenInput) hiddenInput.value = value;

          list.style.display = 'none';
        });
      });
      
      if (select.dataset.name === 'filmscanner' && hiddenInput && !hiddenInput.value) {
        const defaultItem = select.querySelector('li.active');
        if (defaultItem) {
          hiddenInput.value = defaultItem.dataset.value || 'Noritsu';
        }
      }
    });
  
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.custom-select')) {
        document.querySelectorAll('.select-options').forEach((ul) => {
          ul.style.display = 'none';
        });
      }
    });
  
    document.querySelectorAll('.qty-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const container = btn.closest('.qty-controls');
        if (!container) return;
  
        const input = container.querySelector('.qty-input');
        const hidden = document.querySelector('.sync-quantity');
        if (!input || !hidden) return;
  
        let qty = parseInt(input.value, 10) || 1;
  
        if (btn.classList.contains('plus')) qty++;
        if (btn.classList.contains('minus') && qty > 1) qty--;
  
        input.value = qty;
        hidden.value = qty;
      });
    });
  
    const form = document.getElementById('filmOrderForm');
    const popup = document.getElementById('orderConfirmPopup');
    const openBtn = document.getElementById('openPopupBtn');
    const confirmBtn = document.getElementById('confirmSubmit');
    const cancelBtn = document.getElementById('cancelPopup');
  
    openBtn.addEventListener('click', () => {
      const name = document.querySelector('input[name="contact[name]"]')?.value.trim() || '';
      const email = document.querySelector('input[name="contact[email]"]')?.value.trim() || '';
      const filmType = document.querySelector('.sync-filmtype')?.value || '';
      const format = document.querySelector('.sync-filmformat')?.value || '';
  
      if (name === '' || email === '' || filmType === '' || format === '') {
        alert('Please fill in your name, email, film type and format before submitting.');
        return;
      }
  
      const orderId = 'LF0{{ page.metafields.custom.form_id | default: 1 }}';
      document.getElementById('orderIdField').value = orderId;
  
      document.getElementById('popupName').textContent = name || 'friend';
      document.getElementById('popupOrderId').textContent = orderId;
      document.getElementById('popupFilmType').textContent = filmType;
      document.getElementById('popupFormat').textContent = format;
      document.getElementById('popupQuantity').textContent =
        document.querySelector('.sync-quantity')?.value || '1';
  
      popup.style.display = 'flex';
    });
  
    confirmBtn.addEventListener('click', () => {
      form.submit();
  
      const pageForm = '{{ page.metafields.custom.form_id | default: 1 }}';
      const formNumb = parseInt(pageForm, 10) + 1;
  
      fetch('https://hook.us2.make.com/3sphskk6985uxxh0q2bckphkrnh2ojdc', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ value: formNumb })
      });
    });
  
    cancelBtn.addEventListener('click', () => {
      popup.style.display = 'none';
    });
  
    popup.addEventListener('click', (e) => {
      if (e.target === popup) popup.style.display = 'none';
    });

    const addFilmBtn = document.querySelector('.add-film-btn');
    if (addFilmBtn) {
      addFilmBtn.addEventListener('click', () => {
        const originalDuplicate = document.querySelector('.chose_steps_duplicate');
        if (!originalDuplicate) return;

        const clonedDuplicate = originalDuplicate.cloneNode(true);
        
        clonedDuplicate.querySelectorAll('input[type="text"], input[type="email"], input[type="tel"], textarea').forEach(input => {
          input.value = '';
        });
        
        const clonedQtyInput = clonedDuplicate.querySelector('.qty-input');
        if (clonedQtyInput) clonedQtyInput.value = '1';
        
        const clonedQtyHidden = clonedDuplicate.querySelector('.sync-quantity');
        if (clonedQtyHidden) clonedQtyHidden.value = '1';
        
        clonedDuplicate.querySelectorAll('.custom-select').forEach(select => {
          const display = select.querySelector('.selected-text');
          const items = select.querySelectorAll('li');
          
          if (select.dataset.name === 'filmtype' && display) {
            display.textContent = 'Film Type';
          } else if (select.dataset.name === 'filmformat' && display) {
            display.textContent = 'Film Format';
          } else if (select.dataset.name === 'location' && display) {
            display.textContent = 'Select Drop Box Locations';
          } else if (select.dataset.name === 'filmscanSize' && display) {
            display.textContent = 'Scan size';
          } else if (select.dataset.name === 'filmscanner' && display) {
            display.textContent = 'Noritsu (default)';
            items.forEach(item => {
              item.classList.remove('active');
              if (item.dataset.value === 'Noritsu') item.classList.add('active');
            });
          } else if (select.dataset.name === 'filmcontrast' && display) {
            display.textContent = 'Standard';
            items.forEach(item => {
              item.classList.remove('active');
              if (item.dataset.value === 'Standard') item.classList.add('active');
            });
          } else if (select.dataset.name === 'filmbrightness' && display) {
            display.textContent = 'Standard';
            items.forEach(item => {
              item.classList.remove('active');
              if (item.dataset.value === 'Standard') item.classList.add('active');
            });
          }
          
          items.forEach(item => {
            if (item.dataset.value !== 'Standard' && item.dataset.value !== 'Noritsu') {
              item.classList.remove('active');
            }
          });
          
          const hiddenInput = clonedDuplicate.querySelector('.sync-' + select.dataset.name);
          if (hiddenInput) {
            if (select.dataset.name === 'filmcontrast' || select.dataset.name === 'filmbrightness') {
              hiddenInput.value = 'Standard';
            } else if (select.dataset.name === 'filmscanner') {
              hiddenInput.value = 'Noritsu';
            } else {
              hiddenInput.value = '';
            }
          }
        });
        
        addFilmBtn.parentNode.insertBefore(clonedDuplicate, addFilmBtn);
        
        clonedDuplicate.querySelectorAll('.custom-select').forEach((select) => {
          const display = select.querySelector('.selected-text');
          const list = select.querySelector('.select-options');
          const items = select.querySelectorAll('li');
          const hiddenInput = clonedDuplicate.querySelector('.sync-' + select.dataset.name);

          if (!list || !items.length) return;

          const trigger = select.querySelector('.select-display');
          if (trigger) {
            trigger.addEventListener('click', () => {
              list.style.display = list.style.display === 'block' ? 'none' : 'block';
            });
          }

          items.forEach((item) => {
            item.addEventListener('click', () => {
              items.forEach(i => i.classList.remove('active'));
              item.classList.add('active');

              const value = item.textContent.trim();
              if (display) display.textContent = value;
              if (hiddenInput) hiddenInput.value = value;

              list.style.display = 'none';
            });
          });
          
          if (select.dataset.name === 'filmscanner' && hiddenInput && !hiddenInput.value) {
            const defaultItem = select.querySelector('li.active');
            if (defaultItem) {
              hiddenInput.value = defaultItem.dataset.value || 'Noritsu';
            }
          }
        });
        
        clonedDuplicate.querySelectorAll('.qty-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const container = btn.closest('.qty-controls');
            if (!container) return;

            const input = container.querySelector('.qty-input');
            const hidden = clonedDuplicate.querySelector('.sync-quantity');
            if (!input || !hidden) return;

            let qty = parseInt(input.value, 10) || 1;

            if (btn.classList.contains('plus')) qty++;
            if (btn.classList.contains('minus') && qty > 1) qty--;

            input.value = qty;
            hidden.value = qty;
          });
        });
      });
    }
  </script>

  <script>
  document.addEventListener('DOMContentLoaded', function () {
    const negativesOptions = document.querySelectorAll(
      '.negatives-options input[type="radio"]'
    );
    const mailFeeField = document.getElementById('negativesMailFee');

    if (!mailFeeField || !negativesOptions.length) return;

    negativesOptions.forEach(option => {
      option.addEventListener('change', () => {
        const price = option.dataset.price;
        if (price) {
          mailFeeField.value =
            'Additional $12.50 – Negatives mailed back to customer';
        } else {
          mailFeeField.value = '';
        }

        document.querySelectorAll('.negatives-options .option').forEach(label => {
          label.classList.remove('active');
        });
        option.closest('.option')?.classList.add('active');
      });
    });
  });
</script>

  
  
  <style>
      .popup-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.88); display: flex; align-items: center; justify-content: center;
        z-index: 9999; backdrop-filter: blur(6px);
      }
      .popup-content {
        background: white;
        padding: 15px 25px;
        border-radius: 20px;
