  <script>
    (function () {
      async function generateLfId() {
        const res = await fetch('/apps/lf-id', { method: 'POST' });
        if (!res.ok) throw new Error('ID request failed');
        return await res.json();
      }
  
      async function init() {
        try {
          const data = await generateLfId();
          const input = document.getElementById('lf_form_id');
          const preview = document.getElementById('lf_form_id_preview');
  
          if (input) input.value = data.referenceId;
          if (preview) preview.textContent = 'Your reference: ' + data.referenceId;
        } catch (e) {
          console.error(e);
        }
      }
  
      document.addEventListener('DOMContentLoaded', init);
    })();
  </script>
  
