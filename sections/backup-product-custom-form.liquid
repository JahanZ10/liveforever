{% assign raw_handles = '120-ecn-2-develop-scan,
   35mm-ecn-2-develop-scan,
   120-b-w-develop-scan,
   35mm-b-w-develop-scan,
   120-c41-develop-scan,
   35mm-c41-develop-scan'
  | split: ','
%}

<div id="film-products-json" style="display:none;">
  [
  {% for h in raw_handles %}
    {% assign clean_handle = h | strip %}
    {% assign p = all_products[clean_handle] %}
    {% if p %}
      { "handle": "{{ p.handle }}", "title": "{{ p.title | escape }}", "variants": [
      {% for v in p.variants %}
        { "id": "{{ v.id }}", "title": "{{ v.title | escape }}", "price": "{{ v.price | money_without_currency }}",
        "compare_at_price": "{{ v.compare_at_price | money_without_currency }}", "available": {{ v.available | json }},
        "option1": "{{ v.option1 | escape }}", "option2": "{{ v.option2 | escape }}", "option3": "
        {{- v.option3 | escape -}}
        " }{% unless forloop.last %},{% endunless %}
      {% endfor %}
      ] }
    {% endif %}
    {% unless forloop.last %},{% endunless %}
  {% endfor %}
  ]
</div>

<section class="film-order-section">
  <div class="container">
    <h2 class="section-title">Start Your Film Order</h2>
    <p class="section-desc">
      Choose your film type, scan size, and preferences — we’ll handle the rest. Designed for professionals and
      hobbyists who want their film treated with care.
    </p>

    <form class="film-order-form">
      <div class="chose_steps_form_first">
        <div class="form-title">Start Your Film Order</div>
        <p class="form-desc">Tell us about your film -- we'll develop, scan, and send it back with care.</p>

        <!-- Film Block Wrapper (for cloning) -->
        <div class="film-block">
          <div class="form-group film-type">
            <div class="film-type-wrapper">
              <div class="custom-select form-row" data-name="filmType">
                <div class="form-group">
                  <label>Select Your Film Type and Qty</label>
                  <div class="select-display">
                    <span class="selected-text">Film Type</span>
                    <span class="selected-price">$0 USD</span>
                    <span class="arrow">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 30.727 30.727"
                        fill="currentColor"
                      >
                        <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                          c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                          c0.977-0.976,2.559-0.976,3.535,0
                          C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                      </svg>
                    </span>
                  </div>
                  <ul class="select-options">
                    <li data-value="C41" data-price="">
                      <span>C41</span>
                      <span class="price-option"></span>
                    </li>
                    <li data-value="B&W" data-price="">
                      <span>B&W</span>
                      <span class="price-option"></span>
                    </li>
                    <li data-value="ECN-2" data-price="">
                      <span>ECN-2</span>
                      <span class="price-option"></span>
                    </li>
                  </ul>
                </div>
                <div class="form-group">
                  <label style="opacity:0;">Select your Film Format</label>
                  <div class="custom-select" data-name="filmFormat">
                    <div class="select-display">
                      <span class="selected-text">Film Format</span>
                      <span class="arrow">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="14"
                          height="14"
                          viewBox="0 0 30.727 30.727"
                          fill="currentColor"
                        >
                          <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                            c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                            c0.977-0.976,2.559-0.976,3.535,0
                            C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                        </svg>
                      </span>
                    </div>
                    <ul class="select-options">
                      <li data-value="35mm">35mm</li>
                      <li data-value="120">120</li>
                    </ul>
                  </div>
                </div>
              </div>

              <div class="qty-controls">
                <label>Qty</label>
                <div class="qty-controls-input">
                  <input type="number" value="1" min="1" class="qty-input" readonly>
                  <div class="plus_minus_btn">
                    <button type="button" class="qty-btn plus">+</button>
                    <button type="button" class="qty-btn minus">-</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label>Select your scan size</label>
              <div class="custom-select" data-name="filmscanSize">
                <div class="select-display">
                  <span class="selected-text">Scan size</span>
                  <span class="arrow">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 30.727 30.727"
                      fill="currentColor"
                    >
                      <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                        c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                        c0.977-0.976,2.559-0.976,3.535,0
                        C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                    </svg>
                  </span>
                </div>
                <ul class="select-options">
                  <li data-value="Social">Social</li>
                  <li data-value="Classic">Classic</li>
                  <li data-value="Pro">Pro</li>
                  {% comment %} <li data-value="No Scan">No Scan</li> {% endcomment %}
                </ul>
              </div>
            </div>

            <div class="form-group">
              <label>Select your scanner</label>
              <div class="custom-select" data-name="filmscanner">
                <div class="select-display">
                  <span class="selected-text" data-value="Noritsu">Noritsu (default)</span>
                  <span class="arrow">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 30.727 30.727"
                      fill="currentColor"
                    >
                      <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                        c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                        c0.977-0.976,2.559-0.976,3.535,0
                        C30.971,7.624,30.971,9.206,29.994,10.183z"/>
                    </svg>
                  </span>
                </div>
                <ul class="select-options">
                  <li class="active" data-value="Noritsu">Noritsu</li>
                  <li data-value="Fujifilm Frontier">Fujifilm Frontier</li>
                  <li data-value="Imacon Flextight">Imacon Flextight</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- SCAN PREFERENCES -->
          <div class="form-title" style="margin-top: 24px; font-size: 16px;">
            Tell us your scan preferences for the film type (Classic and Pro size scan only)
          </div>
          <div class="form-row-radio">
            <div class="form-group-radio">
              <label>Select your Contrast</label>
              <div class="radio-group" data-name="filmcontrast">
                <label class="radio-option option active"><input type="radio" name="filmcontrast" value="Standard" checked>Standard</label>
                <label class="radio-option option"><input type="radio" name="filmcontrast" value="High">High</label>
                <label class="radio-option option"><input type="radio" name="filmcontrast" value="Low (Flat)">Low (Flat)</label>
              </div>
            </div>

            <div class="form-row-radio">
              <label>Select Brightness</label>

              <div class="radio-group" data-name="filmbrightness">
                <label class="radio-option option active"><input type="radio" name="filmbrightness" value="Standard" checked>Standar</label>
                <label class="radio-option option"><input type="radio" name="filmbrightness" value="Bright">Bright</label>
                <label class="radio-option option"><input type="radio" name="filmbrightness" value="Dark">Dark</label>
              </div>
            </div>
          </div>
        </div>
        <!-- End Film Block -->

        <button type="button" class="add-film-btn">Add another film type +</button>

        <div class="form-group">
          <label for="instructions">Instructions</label>
          <textarea
            id="instructions"
            rows="3"
            placeholder="Let us know any special notes or creative preferences."
          ></textarea>
          <div class="custom-select" data-name="location">
            <div class="select-display">
              <span class="selected-text">Select Drop Box Locations</span>
              <span class="arrow">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 30.727 30.727"
                  fill="currentColor"
                >
                  <path d="M29.994,10.183L15.363,24.812L0.733,10.184c-0.977-0.978-0.977-2.561,0-3.536
                    c0.977-0.977,2.559-0.976,3.536,0l11.095,11.093L26.461,6.647
                    c0.977-0.976,2.559-0.976,3.535,0
                    C30.971,7.624,30.971,9.206,29.994,10.183z"></path>
                </svg>
              </span>
            </div>
            <ul class="select-options">
              <li data-value="location_1">location 1</li>
              <li data-value="location_2">location 2</li>
              <li data-value="location_3">location 3</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Second & Third Sections (unchanged) -->
      <div class="chose_steps_form_second">
        <div class="turnaround">
          <div class="trun_heading">Turnaround time</div>
          <ul class="turnaround-list">
            <li>Colour / B&W: 5–6 working days</li>
            <li>E6 & ECN2: 10 working days</li>
            <li>Prints: 5–6 working days</li>
          </ul>

          <div class="heading_like">What would you like us to do with your negatives?</div>
          <div class="negatives-options">
            <label class="option active">
              <input type="radio" name="negatives" checked>
              <span>Keep (Collect in-store)</span>
            </label>
            <label class="option">
              <input type="radio" name="negatives">
              <span>Mail to me</span>
            </label>
            <label class="option">
              <input type="radio" name="negatives">
              <span>Dispose</span>
            </label>
          </div>

          <p class="note">You can collect your negatives at our lab</p>
          <div class="address">
            <div>Address:</div>
            <div>
              <span>Australia – Filmforever HQ, 2/62 Albemarle Street, Williamstown North, VIC, 3016</span><br>
              <a href="#" target="_blank">View on Google Maps</a>
            </div>
          </div>
        </div>
      </div>

      <div class="chose_steps_form_third">
        <div class="order-summary">
          <div class="order_heading">Order Summary</div>
          <p class="order-summary-text">No items selected</p>
          <div class="order-items-container"></div>
          <p class="notes" style="display: none;"></p>
          <div class="order-total">
            <span>Total:</span>
            <span class="total-price">$0 USD</span>
          </div>
        </div>

        <div class="terms">
          <div class="terms_service">Terms of service</div>
          <p>
            All orders arriving at the same time must be submitted under one form. The number of rolls can be adjusted
            next to the products you've selected.
          </p>
          <p>
            If you need to amend an already submitted form, email us at
            <a href="mailto:support@filmforever.com" class="support_text">support@Filmforever.com</a>
          </p>

          <label class="agree-label">
            <input type="checkbox" required class="agree-checkbox">
            <span>I Agree</span>
          </label>
        </div>

        <div class="form-error-message" style="display: none; color: red; margin-top: 10px; font-size: 14px;"></div>

        <button type="submit" class="checkout-btn">
          Proceed to Checkout <span class="checkout-total">$0 USD</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Modal Popup -->
  <div id="order-info-modal" class="order-modal" style="display: none;">
    <div class="modal-overlay"></div>
    <div class="modal-content">
      <button class="modal-close" aria-label="Close modal">&times;</button>
      <div class="modal-body">
        <p>Info: Please write your Order id on envelop and drop in the dropbox.</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const products = JSON.parse(document.getElementById('film-products-json').textContent);

    window.allSelectedFilms = [];
    window.globalNotes = '';
    window.globalLocation = '';
    window.globalNegatives = 'Keep (Collect in-store)';

    function getBlockData(block) {
      const typeEl = block.querySelector('[data-name="filmType"] .selected-text');
      const formatEl = block.querySelector('[data-name="filmFormat"] .selected-text');
      const scanSizeEl = block.querySelector('[data-name="filmscanSize"] .selected-text');
      const scannerEl = block.querySelector('[data-name="filmscanner"] .selected-text');
      const contrastRadio = block.querySelector('input[name="filmcontrast"]:checked');
      const brightnessEl = block.querySelector('input[name="filmbrightness"]:checked');
      const qty = parseInt(block.querySelector('.qty-input')?.value) || 1;

      const type = typeEl?.textContent.trim();
      const format = formatEl?.textContent.trim();
      const scanSize = scanSizeEl?.textContent.trim() || 'No Scan';
      const scanner = scannerEl?.textContent.trim() || 'Noritsu';
      const contrast = contrastRadio?.value || 'Standard';
      const brightness = brightnessEl?.value || 'Standard';

      if (!type || !format || type === 'Film Type' || format === 'Film Format') return null;

      const search = `${format.toLowerCase()} ${type.toLowerCase()}`;
      const product = products.find((p) => p.title.toLowerCase().includes(search));
      if (!product) return null;

      let bestVariant = product.variants[0];
      let bestScore = 0;

      product.variants.forEach((v) => {
        let score = 0;
        if (v.option1 && v.option1 === scanSize) score += 100;
        if (v.option2 && v.option2 === scanner) score += 50;
        if (v.option3 && v.option3.includes(contrast)) score += 10;
        if (v.option3 && v.option3.includes(brightness)) score += 10;
        if (score > bestScore) {
          bestScore = score;
          bestVariant = v;
        }
      });

      const price = parseFloat(bestVariant.price);
      const displayPrice = Number.isInteger(price) ? price : price.toFixed(2);

      const priceEl = block.querySelector('[data-name="filmType"] .selected-price');
      if (priceEl) priceEl.textContent = `$${displayPrice} USD`;

      const extras = [];
      if (contrast !== 'Normal') extras.push(contrast);
      extras.push(brightness);
      const extraText = extras.length > 0 ? ` • ${extras.join(' + ')}` : '';

      return {
        variantId: bestVariant.id,
        quantity: qty,
        price: price,
        variantTitle: bestVariant.title,
        display: `${qty}× ${product.title}`,
        brightness: brightness,
      };
    }

    function updateAllFilms() {
      window.allSelectedFilms = [];

      document.querySelectorAll('.film-block').forEach((block) => {
        const data = getBlockData(block);
        if (data) window.allSelectedFilms.push(data);
      });

      window.globalNotes = document.getElementById('instructions')?.value.trim() || '';
      const locEl = document.querySelector('[data-name="location"] .selected-text');
      window.globalLocation = locEl?.textContent.trim() || '';

      const checkedNeg = document.querySelector('input[name="negatives"]:checked');
      window.globalNegatives = checkedNeg
        ? checkedNeg.nextElementSibling.textContent.trim()
        : 'Keep (Collect in-store)';

      const container = document.querySelector('.order-items-container');
      const summaryText = document.querySelector('.order-summary-text');
      const totalEl = document.querySelector('.total-price');
      const checkoutBtnTotal = document.querySelector('.checkout-total');
      const notesEl = document.querySelector('.order-summary .notes');

      if (window.allSelectedFilms.length === 0) {
        summaryText.textContent = 'No items selected';
        container.innerHTML = '';
        totalEl.textContent = '$0.00 USD';
        checkoutBtnTotal.textContent = '$0 USD';
        notesEl.style.display = 'none';
        return;
      }

      summaryText.textContent = `${window.allSelectedFilms.length} item${
        window.allSelectedFilms.length > 1 ? 's' : ''
      } selected`;
      container.innerHTML = '';
      let grandTotal = 0;

      window.allSelectedFilms.forEach((item) => {
        const lineTotal = item.price * item.quantity;
        grandTotal += lineTotal;

        const div = document.createElement('div');
        div.style.cssText = 'padding: 12px 0; border-bottom: 1px solid #eee; font-size: 14px;';
        div.innerHTML = `
          <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-weight: 600;">
            <span>${item.display}</span>
            <span>$${lineTotal.toFixed(2)} USD</span>
          </div>
          <div style="color: #666; font-size: 13px; margin-left: 4px;">
            <strong>Selected Options</strong>: ${item.variantTitle} / ${item.brightness}
          </div>
        `;
        container.appendChild(div);
      });

      let notesHtml = '';
      if (window.globalNotes) notesHtml += `<strong>Instructions:</strong> ${window.globalNotes}<br>`;
      if (window.globalLocation && !window.globalLocation.includes('Select Drop')) {
        notesHtml += `<strong>Drop-box Location:</strong> ${window.globalLocation}<br>`;
      }
      notesHtml += `<strong>Negatives:</strong> ${window.globalNegatives}`;

      notesEl.innerHTML = notesHtml;
      notesEl.style.display = 'block';

      const totalFormatted = `$${grandTotal.toFixed(2)} USD`;
      totalEl.textContent = totalFormatted;
      checkoutBtnTotal.textContent = totalFormatted;
    }

    document.querySelectorAll('input[name="negatives"]').forEach((radio) => {
      radio.addEventListener('change', function () {
        document.querySelectorAll('.negatives-options .option').forEach((label) => {
          label.classList.remove('active');
        });
        if (this.checked) {
          this.parentElement.classList.add('active');
        }
        updateAllFilms();
      });
    });

    document.querySelector('input[name="negatives"]:checked')?.parentElement.classList.add('active');

    function initCustomSelect(container) {
      const display = container.querySelector('.select-display');
      const options = container.querySelector('.select-options');
      const text = display.querySelector('.selected-text');

      display.onclick = (e) => {
        e.stopPropagation();
        document.querySelectorAll('.select-options').forEach((o) => (o.style.display = 'none'));
        document.querySelectorAll('.select-display').forEach((d) => d.classList.remove('open'));
        options.style.display = options.style.display === 'block' ? 'none' : 'block';
        display.classList.toggle('open');
      };

      options.querySelectorAll('li').forEach((li) => {
        li.onclick = (e) => {
          e.stopPropagation();
          options.querySelectorAll('li').forEach((i) => i.classList.remove('active'));
          li.classList.add('active');
          text.textContent = li.textContent.trim();
          options.style.display = 'none';
          display.classList.remove('open');
          updateAllFilms();
        };
      });
    }

    function initQty(block) {
      const input = block.querySelector('.qty-input');
      const plus = block.querySelector('.plus');
      const minus = block.querySelector('.minus');
      if (!input) return;
      plus.onclick = () => {
        input.stepUp();
        updateAllFilms();
      };
      minus.onclick = () => {
        input.stepDown();
        updateAllFilms();
      };
      input.onchange = updateAllFilms;
    }

    function initFilmBlock(block) {
      block.querySelectorAll('.custom-select').forEach(initCustomSelect);
      initQty(block);
    }

    document.querySelector('.add-film-btn')?.addEventListener('click', function () {
      const original = document.querySelector('.film-block');
      const clone = original.cloneNode(true);

      clone.querySelector('.qty-input').value = 1;
      clone.querySelectorAll('.selected-text').forEach((span) => {
        const parent = span.closest('.custom-select');
        if (!parent) return;
        const name = parent.dataset.name;
        if (name === 'filmType') span.textContent = 'Film Type';
        else if (name === 'filmFormat') span.textContent = 'Film Format';
        else if (name === 'filmscanSize') span.textContent = 'Scan size';
        else if (name === 'filmscanner') span.textContent = 'Noritsu';
        else if (name === 'filmcontrast') span.textContent = 'Standard';
        else if (name === 'filmbrightness') span.textContent = 'Standard';
      });
      clone.querySelectorAll('.select-options li').forEach((li) => li.classList.remove('active'));
      clone.querySelector('[data-name="filmscanner"] li[data-value="Noritsu"]')?.classList.add('active');
      clone.querySelector('[data-name="filmType"] .selected-price').textContent = '$0 USD';

      clone.style.marginTop = '40px';
      clone.style.paddingTop = '30px';
      clone.style.borderTop = '2px dashed #ccc';

      this.before(clone);
      initFilmBlock(clone);
      updateAllFilms();
    });

    document.getElementById('instructions')?.addEventListener('input', updateAllFilms);
    document.querySelector('[data-name="location"]')?.addEventListener('click', () => setTimeout(updateAllFilms, 100));
    document.querySelectorAll('input[name="negatives"]').forEach((radio) => {
      radio.addEventListener('change', updateAllFilms);
    });

    document.addEventListener('click', () => {
      document.querySelectorAll('.select-options').forEach((o) => (o.style.display = 'none'));
      document.querySelectorAll('.select-display').forEach((d) => d.classList.remove('open'));
    });

    document.querySelectorAll('.film-block').forEach(initFilmBlock);
    document.querySelectorAll('.custom-select').forEach(initCustomSelect);
    updateAllFilms();

    document.querySelector('.checkout-btn').addEventListener('click', async function (e) {
      e.preventDefault();

      // === NEW: Check "I Agree" checkbox ===
      const agreeCheckbox = document.querySelector('.agree-checkbox');
      const errorMessageEl = document.querySelector('.form-error-message');

      if (!agreeCheckbox.checked) {
        errorMessageEl.textContent = 'Please agree to the terms of service before proceeding.';
        errorMessageEl.style.display = 'block';
        agreeCheckbox.closest('.terms').scrollIntoView({ behavior: 'smooth', block: 'center' });
        return; // stop execution
      } else {
        errorMessageEl.style.display = 'none';
      }

      if (window.allSelectedFilms.length === 0) {
        errorMessageEl.textContent = 'Please add at least one film roll before checkout.';
        errorMessageEl.style.display = 'block';
        return;
      }
      // === End of validation ===

      const button = this;
      const originalHtml = button.innerHTML;
      button.disabled = true;
      button.innerHTML = 'Adding to cart…';

      try {
        const itemsToAdd = window.allSelectedFilms.map((item) => ({
          id: item.variantId,
          quantity: item.quantity,
          properties: {
            Brightness: item.brightness,
            ...(window.globalNotes && { Instructions: window.globalNotes }),
            ...(window.globalLocation &&
              window.globalLocation !== 'Select Drop Box Locations' && { 'Drop-box Location': window.globalLocation }),
            Negatives: window.globalNegatives,
          },
        }));

        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({ items: itemsToAdd }),
        });

        if (!response.ok) {
          const err = await response.json();
          throw new Error(err.message || err.description || 'Failed to add to cart');
        }

        const attributes = {};
        if (window.globalNotes) attributes['Instructions'] = window.globalNotes;
        if (window.globalLocation && window.globalLocation !== 'Select Drop Box Locations') {
          attributes['Drop-box Location'] = window.globalLocation;
        }
        attributes['Negatives'] = window.globalNegatives;

        if (Object.keys(attributes).length > 0) {
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attributes }),
          });
        }

        window.location.href = '/checkout';
      } catch (err) {
        console.error(err);
        errorMessageEl.textContent = 'Error: ' + (err.message || 'Something went wrong. Please try again.');
        errorMessageEl.style.display = 'block';
        button.disabled = false;
        button.innerHTML = originalHtml;
      }
    });

    window.getOrder = () => ({
      items: window.allSelectedFilms,
      notes: window.globalNotes,
      location: window.globalLocation,
      negatives: window.globalNegatives,
    });

    document.addEventListener('change', function (e) {
      const radio = e.target;
      if (!radio.matches('input[type="radio"]')) return;

      const group = radio.closest('[data-name="filmcontrast"], [data-name="filmbrightness"]');
      if (!group) return;

      group.querySelectorAll('.radio-option').forEach((opt) => opt.classList.remove('active'));

      radio.closest('.radio-option').classList.add('active');
      updateAllFilms();
    });
  });
</script>

<script>
  // Hide The Fuji For Social size
  document.addEventListener('DOMContentLoaded', function() {
    const scanSizeSelect = document.querySelector('[data-name="filmscanSize"]');
    const scannerSelect = document.querySelector('[data-name="filmscanner"]');
    const fujiOption = scannerSelect.querySelector('li[data-value="Fujifilm Frontier"]');
    const selectedText = scanSizeSelect.querySelector('.selected-text');

    function updateScannerOptions() {
      const selectedScanSize = selectedText.textContent.trim();

      if (selectedScanSize === "Social") {
        if (fujiOption) fujiOption.style.display = 'none';
      } else {
        if (fujiOption) fujiOption.style.display = 'block';
      }
    }

    const observer = new MutationObserver(updateScannerOptions);

    observer.observe(selectedText, {
      childList: true,
      subtree: true
    });

    updateScannerOptions();
  });
</script>

