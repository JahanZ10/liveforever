<section
  id="whats-on-testimonials"
  class="whats-on-testimonials-main"
  style="
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  "
>
    <div class="whats-on-testimonial">
      <div class="header-text">
        <h2 
            style="color: {{ section.settings.text_color }};
            font-size: {{ section.settings.heading_size }}px;
            margin: 10px 0;">
            {{ section.settings.heading }}
        </h2>
      </div>
      <div class="testimonial-container">
        {% for block in section.blocks %}
            <div class="testimonial_content">
                <div class="content_desp" style="font-size:{{ section.settings.subheading_size }}px;">“{{ block.settings.description }}”</div>
                <p class="name_auth">{{ block.settings.auth_name }}</p>
                <div class="star_rating">★★★★★</div>
            </div>
        {% endfor %}
      </div>
    </div>

    <div class="nav-buttons">
        <button class="button-prev-test">
            <img src="https://cdn.shopify.com/s/files/1/0949/0576/2156/files/Group_47.png?v=1762885714" width="30" height="30">
        </button>
        <button class="button-next-test">
            <img src="https://cdn.shopify.com/s/files/1/0949/0576/2156/files/Group_48.png?v=1762885714" width="30" height="30">
        </button>
    </div>
    {% if section.settings.show_bottom_marquee %}
        <div class="bottom-marquee-test">
            <div class="marquee-track-test">
            {% for i in (1..100) %}
                <div class="marquee-logos-test"></div>
            {% endfor %}
            {% for i in (1..100) %}
                <div class="marquee-logos-test"></div>
            {% endfor %}
            </div>
        </div>
    {% endif %}

</section>

  <style>
    .whats-on-testimonials-main {
        margin: 40px 0;
        border-radius: 20px 20px 0 0;
        padding-bottom: 20px;
        position: relative;
    }
    .whats-on-testimonial{
        padding: 4% 4% 1%;
    }
    .whats-on-testimonial .container {
      margin: auto;
    }
    .content_desp{
        font-weight: 500;
        line-height: normal;
        margin: 30px 0;
        max-width: 950px;
    }
    .name_auth{
        font-size: 20px;
        font-weight: 600;
        line-height: normal;
        margin: 0;
    }
    .star_rating{
        font-weight: 600;
        font-size: 22px;
        line-height: normal;
    }
    .nav-buttons button {
      background: {{ section.settings.button_bg }};
      border: none;
      border-radius: 50%;
      cursor: pointer;
      font-size: 2rem;
      color: {{ section.settings.text_color }};
        width: 30px;
        height: 30px;
        padding: 0;
    }
    .button-next-test ,
    .button-prev-test {
        display: flex;
    }
    .testimonial-card {
        width: 100%;
        padding: 0 5px;
    }
    .product-info {
        padding: 15px;
    }
    .testimonial_content{
        width: 100%;
    }
    .testimonial-container .flickity-page-dots {
        flex-wrap: nowrap;
        display: flex;
        position: absolute;
        width: 20%;
        bottom: -80px;
        padding: 0;
        margin: 0;
        list-style: none;
        text-align: center;
        line-height: 1;
        right: 0%;
        transform: translateX(-0%);
    }
    .nav-buttons{
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 0 5% 4%;
    }
    .testimonial-container .flickity-page-dots .dot.is-selected {
        background: #000;
    }
    .testimonial-container .flickity-page-dots .dot {
        width: 100%;
        height: 3px;
        margin: 0;
        border-radius: 0;
        background: #fff;
        opacity: 1;
    }
    .testimonial-container .flickity-page-dots .dot:first-child {
        border-radius: 10px 0 0 10px;
    }
    .testimonial-container .flickity-page-dots .dot:last-child {
        border-radius: 0 10px 10px 0;
    }
    .testimonial-container .flickity-prev-next-button {
        top: -10%;
        width: 30px;
        height: 30px;
        opacity: 0 !important;
    }
    .testimonial-container .flickity-prev-next-button.previous {
        left: auto;
        right: 173px;
    }
    .testimonial-container .flickity-prev-next-button.next {
        right: 132px;
    }
    .bottom-marquee-test {
        display: flex;
        align-items: center;
        overflow: hidden;
        position: relative;
        white-space: nowrap;
        }

        .marquee-track-test {
        display: flex;
        gap: 10px;
        animation: marquee-logos-test 100s linear infinite;
        }

        .marquee-logos-test {
        display: block !important;
        width: 25px;
        height: 14px;
        border-radius: 5px;
        background: #fff;
        }

        @keyframes marquee-logos-test {
            from {
                transform: translateX(0);
            }
            to {
                transform: translateX(-50%);
            }
        }
    @media (max-width: 1500px) {
        .testimonial-container .flickity-page-dots {
            bottom: -70px;
        }
    }
    @media (max-width: 1500px) {
        .testimonial-container .flickity-page-dots {
            bottom: -70px;
        }
    }
    @media (max-width: 1100px) {
        .testimonial-container .flickity-page-dots {
            bottom: -60px;
        }
    }
    @media (max-width: 999px) {
        .testimonial-card {
            width: 100%;
        }
        .header-row {
            padding: 15px 0px 40px;
        }
    }

    @media (max-width: 600px) {
        .testimonial-card {
            width: 100%;
        }
        .header-row {
            padding: 15px 0px 20px;
        }
        .header-text h2{
            font-size: 20px !important;
        }
        .header-text p{
            font-size: 12px !important;
        }
        .content_desp {
            margin: 15px 0;
            font-size: 20px !important;
        }
        .nav-buttons {
            padding: 0 5% 7%;
        }
        .testimonial-container .flickity-page-dots {
            bottom: -45px;
        }
        .name_auth {
            font-size: 16px;
        }
        .star_rating {
            font-size: 18px;
        }
        .testimonial-container .flickity-page-dots {
            width: 40%;
        }
    }
  </style>


<link rel="stylesheet" href="https://unpkg.com/flickity@2/dist/flickity.min.css">
<script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js"></script>


<script>
    document.addEventListener("DOMContentLoaded", function () {
    const sliderElem = document.querySelector('.testimonial-container');
    if (!sliderElem) return;

    const flkty = new Flickity(sliderElem, {
        cellAlign: 'left',
        groupCells: true,
        contain: true,
        pageDots: true,
        prevNextButtons: false,
        wrapAround: false,
        draggable: true
    });

    const prevBtn = document.querySelector('.button-prev-test');
    const nextBtn = document.querySelector('.button-next-test');

    if (prevBtn) prevBtn.addEventListener('click', () => flkty.previous());
    if (nextBtn) nextBtn.addEventListener('click', () => flkty.next());

    let wheelTimer;
    sliderElem.addEventListener(
        'wheel',
        function (e) {
        if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
        if (wheelTimer) return;
        if (e.deltaX > 0) flkty.next();
        else flkty.previous();
        wheelTimer = setTimeout(() => (wheelTimer = null), 300);
        },
        { passive: true }
    );
    });
</script>


{% schema %}
{
  "name": "Testimonials Peoples",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#FEC340"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Testimonials Peoples"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Arrow Background",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_marquee",
      "label": "Show Marquee",
      "default": true
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "default": 28,
      "min": 16,
      "max": 100,
      "unit": "px"
    },
    {
        "type": "range",
        "id": "subheading_size",
        "label": "Font Size Description",
        "default": 32,
        "min": 12,
        "max": 80,
        "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "testimonials-content",
      "name": "Testimonials Content",
      "settings": [
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "The fastest turnaround I’ve ever had. My scans were gorgeous – colours just popped."
        },
        {
          "type": "text",
          "id": "auth_name",
          "label": "Name",
          "default": "Sarah M"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Peoples",
      "blocks": [
        {
          "type": "testimonials-content",
          "settings": {
            "description": "The fastest turnaround I’ve ever had. My scans were gorgeous – colours just popped.",
            "auth_name": "Sarah M"
          }
        }
      ]
    }
  ]
}
{% endschema %}